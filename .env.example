NODE_ENV=development
API_PORT=3000
SWAGGER_ENABLED=true
WEB_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
DATABASE_URL=postgresql://evseye:evseye@localhost:5433/evseye?schema=public
REDIS_URL=redis://localhost:6380
JWT_ACCESS_SECRET=replace-with-a-minimum-32-character-development-secret
JWT_REFRESH_SECRET=replace-with-a-different-minimum-32-character-development-secret
OTP_HASH_SECRET=replace-with-a-third-minimum-32-character-development-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
API_RATE_LIMIT=120
API_RATE_TTL_MS=60000
IOT_OFFLINE_THRESHOLD_SECONDS=60
# Local Docker Compose overrides these values for MinIO.
# Production: set S3_BUCKET to the private AWS S3 bucket and leave both endpoints unset.
S3_BUCKET=evs-eye-local
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
# Client logos use presigned PUT/GET URLs, not MEDIA_PUBLIC_BASE_URL.
# Development: http://localhost:9000/evs-eye-local.
# Production: your CloudFront distribution (for example https://media.evseye.io),
# with S3 kept private through Origin Access Control.
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/evs-eye-local
S3_SERVER_SIDE_ENCRYPTION=AES256
S3_SIGNED_URL_TTL_SECONDS=300
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Select console for local testing or telipia for real SMS delivery.
SMS_PROVIDER=console
# Use the provider's verified HTTPS endpoint. Never put live credentials here.
# TELIPIA_API_URL=https://verified-provider-host/sms-panel/api/http/index.php
# TELIPIA_USERNAME=configure-in-secret-manager
# TELIPIA_API_KEY=configure-in-secret-manager
# TELIPIA_SENDER=your-registered-sender-id
# TELIPIA_ROUTE=TRANS
# TELIPIA_LOGIN_TEMPLATE_ID=your-approved-login-template-id
# A separate approved template is required for deallocation OTPs.
# TELIPIA_DEALLOCATION_TEMPLATE_ID=your-approved-deallocation-template-id
# Legacy RiderKyc setting; new verification routing uses the provider registry.
KYC_PROVIDER=sandbox
KYC_ENABLED=false
KYC_SANDBOX_ENVIRONMENT=TEST
KYC_SANDBOX_SECRET_REFERENCE=env:KYC_SANDBOX_TEST
KYC_SANDBOX_API_KEY=
KYC_SANDBOX_API_SECRET=
# KYC_FINGERPRINT_SECRET=replace-with-a-unique-random-value-of-at-least-32-characters
KYC_OPS_STUCK_PROCESSING_MINUTES=10
KYC_OPS_STUCK_PROVIDER_MINUTES=5
KYC_OPS_ACTION_REQUIRED_MINUTES=1440
KYC_OPS_REVIEW_SLA_MINUTES=240
KYC_OPS_ALERT_MIN_SAMPLES=20
KYC_OPS_ALERT_TECHNICAL_RATE_PERCENT=25
KYC_OPS_MAX_TECHNICAL_RETRIES=1
KYC_ANALYTICS_MIN_SAMPLE_SIZE=30
KYC_ROUTING_DEADLINE_MS=30000

# Keep disabled until Cashfree credentials, webhook, and package entitlement are configured.
PAYMENT_PROVIDER=disabled
CASHFREE_ENVIRONMENT=SANDBOX
CASHFREE_API_VERSION=2025-01-01
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_SUBSCRIPTION_RETURN_URL=http://localhost:3001/payments/autopay/return
CASHFREE_WEBHOOK_URL=http://localhost:3000/api/v1/webhooks/payments/cashfree
CASHFREE_PG_WEBHOOK_URL=http://localhost:3000/api/v1/webhooks/payments/cashfree/checkout
KYC_API_BASE_URL=
KYC_API_KEY=

# Welcome emails: configure the auth key privately, then select msg91.
EMAIL_PROVIDER=disabled
# MSG91_AUTH_KEY=configure-in-secret-manager
MSG91_EMAIL_DOMAIN=mail.evseye.com
MSG91_EMAIL_FROM=no-reply@mail.evseye.com
MSG91_WELCOME_TEMPLATE_ID=welcome_client_mail
CLIENT_LOGIN_URL=http://localhost:3001/

# Client subdomains (comma-separated); production: evseye.com
APP_BASE_DOMAINS=localhost
# Non-client application/API hosts. Never list an actual client's hostname here.
APP_GENERIC_HOSTS=localhost,127.0.0.1
# Shared server-only secret for Next -> API; replace with a random secret in production.
CLIENT_PROXY_SECRET=local-client-gateway-development-secret-please-change
# Next server only. Docker Compose sets this to http://api:3000/api/v1.
API_INTERNAL_URL=http://localhost:3000/api/v1

# Next server only. Secure defaults to true; set false ONLY for local HTTP.
SESSION_COOKIE_SECURE=false

# Nearest Hub (routing keys are backend-only)
NEAREST_HUB_ENABLED=true
NEAREST_HUB_RADIUS_STEPS_KM=5,10,25,50
NEAREST_HUB_MAX_RADIUS_KM=50
NEAREST_HUB_CANDIDATE_LIMIT=10
NEAREST_HUB_RESULT_LIMIT=5
ROUTING_PROVIDER_ORDER=GOOGLE,MAPBOX
GOOGLE_ROUTES_ENABLED=false
GOOGLE_ROUTES_API_KEY=
GOOGLE_ROUTES_MONTHLY_LIMIT=12000
GOOGLE_ROUTES_TIMEOUT_MS=3000
MAPBOX_ROUTES_ENABLED=false
MAPBOX_ACCESS_TOKEN=
MAPBOX_ROUTES_MONTHLY_LIMIT=15000
MAPBOX_ROUTES_TIMEOUT_MS=3000
ROUTING_CACHE_ENABLED=true
ROUTING_CACHE_TTL_SECONDS=300
ROUTING_QUOTA_TIMEZONE=Asia/Kolkata
