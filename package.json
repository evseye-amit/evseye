{
  "name": "evs-eye",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "dev:api": "pnpm --filter @evs-eye/api start:dev",
    "dev:web": "pnpm --filter @evs-eye/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter @evs-eye/api test && pnpm test:web && pnpm test:gateway",
    "test:e2e": "pnpm --filter @evs-eye/api test:e2e",
    "typecheck": "pnpm -r typecheck",
    "verify": "pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "pnpm --filter @evs-eye/api exec prisma generate",
    "db:migrate": "pnpm --filter @evs-eye/api exec prisma migrate dev",
    "db:seed": "node --env-file=.env apps/api/prisma/seed.mjs",
    "db:seed:super-admin": "node --env-file=.env apps/api/prisma/seed-super-admin.mjs",
    "db:seed:master-data": "node --env-file=.env apps/api/prisma/seed-master-data.mjs",
    "db:seed:yogmaya": "node --env-file=.env -e \"import { createPrismaClient } from './apps/api/prisma/prisma-client.mjs'; import { seedYogmaya } from './apps/api/prisma/seed-yogmaya.mjs'; const prisma = createPrismaClient(); seedYogmaya(prisma).finally(() => prisma.\\$disconnect());\"",
    "db:seed:features": "node --env-file=.env apps/api/prisma/seed-features.mjs",
    "db:seed:third-party-config": "node --env-file=.env apps/api/prisma/create-third-party-config.mjs",
    "db:seed:all": "pnpm db:seed",
    "test:client-access": "node --env-file=.env test/client-access.mjs",
    "test:gateway": "node --test test/gateway-security.test.mjs",
    "generate:prelogin-contract": "node scripts/generate-prelogin-contract.mjs",
    "verify:prelogin-contract": "node scripts/verify-flutter-prelogin-contract.mjs",
    "test:prelogin:staging": "node test/prelogin-staging.mjs",
    "test:login:staging": "node test/login-staging.mjs",
    "test:web": "pnpm --filter @evs-eye/web test"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
