/// A client-specific feature entitlement.  ADD_ON rows are deliberately kept
/// separate from package inclusions, so a negotiated client add-on never
/// changes the platform Feature or Package master.
model ClientFeature {
  id               String                 @id @default(uuid())
  clientId         String
  client           Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  subscriptionId   String
  subscription     ClientSubscription     @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  featureId        String
  feature          Feature                @relation(fields: [featureId], references: [id], onDelete: Restrict)
  source           ClientFeatureSource    @default(ADD_ON)
  enabled          Boolean                @default(true)
  includedQuantity Decimal                @default(0) @db.Decimal(14, 3)
  usageLimit       Decimal?               @db.Decimal(14, 3)
  unlimitedUsage   Boolean                @default(false)
  effectiveFrom    DateTime               @db.Date
  effectiveTo      DateTime?              @db.Date
  configuration    Json?
  pricing          ClientFeaturePricing[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@unique([subscriptionId, featureId])
  @@index([clientId, enabled, effectiveFrom])
  @@index([featureId])
}

/// Customer-specific feature price snapshots.  These preserve agreed prices
/// even when the catalog FeaturePricing changes later.
model ClientFeaturePricing {
  id               String         @id @default(uuid())
  clientFeatureId  String
  clientFeature    ClientFeature  @relation(fields: [clientFeatureId], references: [id], onDelete: Cascade)
  featurePricingId String
  featurePricing   FeaturePricing @relation(fields: [featurePricingId], references: [id], onDelete: Restrict)
  currency         String         @default("INR") @db.Char(3)
  listUnitPrice    Decimal        @db.Decimal(14, 4)
  discountType     String?        @db.VarChar(20)
  discountValue    Decimal?       @db.Decimal(14, 4)
  finalUnitPrice   Decimal        @db.Decimal(14, 4)
  setupFee         Decimal        @default(0) @db.Decimal(14, 2)
  effectiveFrom    DateTime       @db.Date
  effectiveTo      DateTime?      @db.Date
  reason           String?        @db.VarChar(500)
  approvedBy       String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([clientFeatureId, effectiveFrom])
  @@index([featurePricingId])
}

model ClientPricingAdjustment {
