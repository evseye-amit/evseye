  referenceId String?               @db.VarChar(120)
  createdAt   DateTime              @default(now())

  @@index([clientId, mandateId, createdAt])
}

model PaymentProviderEvent {
  id                   String                     @id @default(uuid())
  provider             String                     @db.VarChar(30)
  eventKey             String                     @db.VarChar(128)
  eventType            String                     @db.VarChar(100)
  payloadHash          String                     @db.VarChar(64)
  clientId             String?
  client               Client?                    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  mandateId            String?
  mandate              PaymentMandate?            @relation(fields: [clientId, mandateId], references: [clientId, id], onDelete: Restrict)
  paymentTransactionId String?
  paymentTransaction   PaymentTransaction?        @relation(fields: [clientId, paymentTransactionId], references: [clientId, id], onDelete: Restrict)
  collectionRequestId  String?
