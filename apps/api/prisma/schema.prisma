generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  CLIENT_ADMIN
  OPERATIONS_MANAGER
  FLEET_MANAGER
  TEAM_LEAD
  KYC_OPERATOR
  RIDER
}

enum OtpPurpose {
  LOGIN
  DEALLOCATION_RIDER
  DEALLOCATION_OPERATOR
  PHONE_VERIFICATION
}

enum OtpStatus {
  PENDING
  VERIFIED
  EXPIRED
  FAILED
  CANCELLED
}

enum RiderStatus {
  ONBOARDING
  ACTIVE
  INACTIVE
  BLOCKED
  EXITED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum HubType {
  OPERATIONS
  PARKING
  CHARGING
  BATTERY_SWAP
  MAINTENANCE
  WAREHOUSE
  DELIVERY
  MIXED
}

enum HubStatus {
  ACTIVE
  INACTIVE
  TEMPORARILY_CLOSED
  UNDER_MAINTENANCE
  FULL
}

enum ClientOnboardingStep {
  HUBS
  FLEET_MANAGERS
  TEAM_LEADERS
  FLEETS
  RIDERS
  REVIEW
}

enum ClientOnboardingStepStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum ImportEntityType {
  HUB
  FLEET_MANAGER
  TEAM_LEADER
  FLEET
  RIDER
}

enum ImportStatus {
  PASS
  PARTIAL_PASS
  FAIL
}

enum PhotoEntityType {
  RIDER
  FLEET
  BATTERY
  CONTROLLER
  INSPECTION
}

enum PhotoStatus {
  PENDING_UPLOAD
  COMPLETE
  FAILED
  DELETED
}

enum KycType {
  AADHAAR
  PAN
  BANK_ACCOUNT
}

enum KycStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  FAILED
  RETRY_REQUIRED
}

enum FleetStatus {
  IN_TRANSIT
  AVAILABLE
  RESERVED
  ALLOCATION_IN_PROGRESS
  ALLOCATED
  IN_USE
  DEALLOCATION_IN_PROGRESS
  INSPECTION_PENDING
  MAINTENANCE
  OUT_OF_SERVICE
}

enum FleetOnboardingStatus {
  DRAFT
  IN_PROGRESS
  PENDING_REVIEW
  ACTIVE
  REJECTED
  ARCHIVED
}

enum VehicleSpeedType {
  SLOW_SPEED
  HIGH_SPEED
}

enum FleetOwnershipType {
  CLIENT_OWNED
  LEASED
  ATTACHED
  OEM_OWNED
  THIRD_PARTY
}

enum BatteryType {
  FIXED_SINGLE
  FIXED_DOUBLE
  SWAP_IF
  SWAP_BS
  SWAP_MOVING
  SWAP_OTHER
}

enum BatteryStatus {
  AVAILABLE
  INSTALLED
  CHARGING
  IN_SWAP
  UNDER_MAINTENANCE
  DAMAGED
  RETIRED
}

enum BatteryChemistry {
  LFP
  NMC
  LTO
  LEAD_ACID
  OTHER
}

enum BatterySlot {
  PRIMARY
  SECONDARY
  AUXILIARY
}

enum ControllerStatus {
  AVAILABLE
  INSTALLED
  UNDER_MAINTENANCE
  DAMAGED
  RETIRED
}

enum InsuranceType {
  THIRD_PARTY
  COMPREHENSIVE
  OWN_DAMAGE
}

enum FleetDocumentType {
  RC
  INSURANCE
  FITNESS_CERTIFICATE
  PERMIT
  PUC
  INVOICE
  WARRANTY
  OTHER
}

enum IoTDeviceStatus {
  ACTIVE
  INACTIVE
  OFFLINE
  DAMAGED
  UNASSIGNED
}

enum FleetTransferStatus {
  INITIATED
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum AllocationStatus {
  INITIATED
  INSPECTION_PENDING
  OTP_PENDING
  ACTIVE
  DEALLOCATION_INITIATED
  COMPLETED
  CANCELLED
}

enum InspectionType {
  PRE_ALLOCATION
  POST_DEALLOCATION
}

enum InspectionStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum IoTEventType {
  LOCATION
  HEARTBEAT
  START
  STOP
}

enum MasterRecordStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum EnergyType {
  ELECTRIC
  HYBRID
  PETROL
  DIESEL
  CNG
  HYDROGEN
  OTHER
  LPG
}

enum VehicleUsageType {
  PRIVATE
  PASSENGER
  GOODS
  DELIVERY
  SHARED_MOBILITY
  PUBLIC_TRANSPORT
  STAFF_TRANSPORT
  SCHOOL_TRANSPORT
  EMERGENCY
  AGRICULTURAL
  CONSTRUCTION
  INDUSTRIAL
  RENTAL
  GOVERNMENT
  SPECIAL_PURPOSE
}

enum PricingModel {
  FREE
  INCLUDED
  FLAT_FEE
  PER_UNIT
  TIERED
  VOLUME
  PER_USER
  PER_RIDER
  PER_VEHICLE
  PER_FLEET
  USAGE_BASED
  PER_DEVICE
  ONE_TIME
  CUSTOM
}

enum BillingCycle {
  ONCE
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
}

enum ClientFeatureSource {
  PACKAGE
  ADD_ON
  CUSTOM
  PROMOTIONAL
}

enum ClientStatus {
  DRAFT
  CREATED
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  SUSPENDED
}

enum ClientContactRole {
  PRIMARY
  ACCOUNT_ADMIN
  BILLING
}

enum ClientAddressType {
  REGISTERED
  BILLING
}

enum ClientDocumentType {
  PAN_CARD
  GST_CERTIFICATE
  INCORPORATION_CERTIFICATE
  FLEET_AGREEMENT
  BUSINESS_AGREEMENT
}

enum DocumentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum FleetBusinessModel {
  OWNED
  LEASED
  ATTACHED
  MIXED
}

enum VehicleOwnership {
  OWNED
  LEASED
  DRIVER_OWNED
  MIXED
}

enum ClientIndustry {
  LOGISTICS
  LAST_MILE
  DELIVERY
  MOBILITY
  RENTAL
  OTHER
}

enum FeatureCategory {
  LOGIN
  RIDER_ONBOARDING
  RIDER_VERIFICATION
  RIDER_TRAINING
  RIDER_MANAGEMENT
  ATTENDANCE
  FACE_RECOGNITION
  FLEET_MANAGEMENT
  VEHICLE_MANAGEMENT
  IOT_TELEMATICS
  TRACKING_GEOFENCING
  BATTERY_MANAGEMENT
  SERVICE_MAINTENANCE
  MECHANIC_MANAGEMENT
  SAFETY_COMPLIANCE
  ANALYTICS
  REPORTING
  NOTIFICATION
  INTEGRATION
  API_ACCESS
  USER_ACCESS
  DOCUMENT_MANAGEMENT
  USER_VERIFICATION
  COUPON
  TRAINING
  SUPPORT
  AI_AUTOMATION
}

enum FeatureType {
  BOOLEAN
  QUANTITY
  USAGE_BASED
  CONFIGURATION
}

enum FeatureBillingUnit {
  VERIFICATION
  RIDER
  VEHICLE
  FLEET
  USER
  API_CALL
  FACE_SCAN
  TRAINING
  DEVICE
  MONTH
  LIFE_TIME
}

model Client {
  id                         String                            @id @default(uuid())
  name                       String
  slug                       String                            @unique
  companyCode                String?                           @unique
  status                     ClientStatus                      @default(DRAFT)
  isActive                   Boolean                           @default(true)
  users                      User[]
  riders                     Rider[]
  photos                     Photo[]
  hubs                       Hub[]
  fleets                     Fleet[]
  batteries                  Battery[]
  controllers                Controller[]
  iotDevices                 IoTDevice[]
  fleetTransfers             FleetTransfer[]
  auditLogs                  AuditLog[]
  businessProfile            ClientBusinessProfile?
  contacts                   ClientContact[]
  addresses                  ClientAddress[]
  operationsProfile          ClientOperationsProfile?
  billingProfile             ClientBillingProfile?
  documents                  ClientDocument[]
  agreement                  ClientAgreement?
  subscriptions              ClientSubscription[]
  clientFeatures             ClientFeature[]
  featureUsage               FeatureUsage[]
  operationVehicleCategories ClientOperationsVehicleCategory[]
  onboardingProgress         ClientOnboardingProgress?
  onboardingSteps            ClientOnboardingStepRecord[]
  importJobs                 ImportJob[]
  userHubs                   UserHub[]
  teamLeaderProfiles         TeamLeaderProfile[]
  teamLeaderRiders           TeamLeaderRider[]
  createdAt                  DateTime                          @default(now())
  updatedAt                  DateTime                          @updatedAt
}

model Oem {
  id            String             @id @default(uuid())
  code          String             @unique
  name          String
  displayName   String
  status        MasterRecordStatus @default(ACTIVE)
  logoObjectKey String?
  website       String?
  description   String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  fleets        Fleet[]

  @@index([status, displayName])
}

model VehicleCategory {
  id               String                            @id @default(uuid())
  code             String                            @unique
  name             String
  description      String?
  status           MasterRecordStatus                @default(ACTIVE)
  displayOrder     Int                               @default(0)
  createdAt        DateTime                          @default(now())
  updatedAt        DateTime                          @updatedAt
  vehicleTypes     VehicleType[]
  fleets           Fleet[]
  clientOperations ClientOperationsVehicleCategory[]

  @@index([status, displayOrder, name])
}

model VehicleType {
  id          String             @id @default(uuid())
  categoryId  String
  category    VehicleCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  code        String             @unique
  name        String
  subCategory String?
  description String?
  energyType  EnergyType
  usageType   VehicleUsageType?
  status      MasterRecordStatus @default(ACTIVE)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  fleets      Fleet[]

  @@index([categoryId, status, name])
}

model Package {
  id            String               @id @default(uuid())
  code          String               @unique
  name          String
  description   String?
  monthlyPrice  Decimal?             @db.Decimal(12, 2)
  yearlyPrice   Decimal?             @db.Decimal(12, 2)
  currency      String               @default("INR") @db.Char(3)
  maxFleets     Int?
  maxRiders     Int?
  trialDays     Int                  @default(0)
  displayOrder  Int                  @default(0)
  isCustom      Boolean              @default(false)
  isActive      Boolean              @default(true)
  features      PackageFeature[]
  subscriptions ClientSubscription[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([isActive, isCustom, displayOrder])
}

model Feature {
  id           String             @id @default(uuid())
  code         String             @unique
  name         String
  category     FeatureCategory
  featureType  FeatureType
  billingUnit  FeatureBillingUnit
  description  String?
  displayOrder Int                @default(0)
  isActive     Boolean            @default(true)
  pricing      FeaturePricing[]
  packageLinks PackageFeature[]
  clientLinks  ClientFeature[]
  usage        FeatureUsage[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([isActive, category, displayOrder])
}

model PackageFeature {
  id               String   @id @default(uuid())
  packageId        String
  package          Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  featureId        String
  feature          Feature  @relation(fields: [featureId], references: [id], onDelete: Restrict)
  enabled          Boolean  @default(true)
  includedQuantity BigInt?
  usageLimit       BigInt?
  unlimitedUsage   Boolean  @default(false)
  configuration    Json?
  displayOrder     Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([packageId, featureId])
}

model FeaturePricing {
  id            String                 @id @default(uuid())
  featureId     String
  feature       Feature                @relation(fields: [featureId], references: [id], onDelete: Cascade)
  pricingModel  PricingModel
  billingUnit   FeatureBillingUnit
  currency      String                 @default("INR") @db.Char(3)
  basePrice     Decimal                @default(0) @db.Decimal(12, 3)
  unitPrice     Decimal                @default(0) @db.Decimal(12, 3)
  costPrice     Decimal                @default(0) @db.Decimal(12, 3)
  minimumCharge Decimal?               @db.Decimal(12, 2)
  maximumCharge Decimal?               @db.Decimal(12, 2)
  setupFee      Decimal                @default(0) @db.Decimal(12, 2)
  billingCycle  BillingCycle?
  taxInclusive  Boolean                @default(false)
  effectiveFrom DateTime               @default(now())
  effectiveTo   DateTime?
  isActive      Boolean                @default(true)
  metadata      Json?
  tiers         FeaturePricingTier[]
  clientPricing ClientFeaturePricing[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([featureId, isActive, effectiveFrom])
}

model FeaturePricingTier {
  id               String         @id @default(uuid())
  featurePricingId String
  featurePricing   FeaturePricing @relation(fields: [featurePricingId], references: [id], onDelete: Cascade)
  tierOrder        Int
  tierName         String?        @db.VarChar(100)
  fromQuantity     BigInt
  toQuantity       BigInt?
  unitPrice        Decimal        @db.Decimal(12, 3)
  costPrice        Decimal?       @db.Decimal(12, 3)
  createdAt        DateTime       @default(now())

  @@unique([featurePricingId, tierOrder])
}

model ClientBusinessProfile {
  id                  String          @id @default(uuid())
  clientId            String          @unique
  client              Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  legalCompanyName    String
  clientType          String
  businessType        String
  industry            ClientIndustry?
  gstin               String?
  pan                 String
  cinOrLlpin          String?
  website             String?
  logoObjectKey       String?
  yearEstablished     Int?
  estimatedFleetSize  Int?
  estimatedRiderCount Int?
  estimatedUserCount  Int?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}

model ClientContact {
  id              String            @id @default(uuid())
  clientId        String
  client          Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  role            ClientContactRole
  name            String
  designation     String?
  mobile          String?
  email           String?
  alternateMobile String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([clientId, role])
  @@index([clientId, role])
}

model ClientAddress {
  id        String            @id @default(uuid())
  clientId  String
  client    Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type      ClientAddressType
  line1     String
  line2     String?
  landmark  String?
  city      String
  district  String?
  state     String
  country   String            @default("India")
  pinCode   String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([clientId, type])
}

model ClientOperationsProfile {
  id                    String                            @id @default(uuid())
  clientId              String                            @unique
  client                Client                            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fleetBusinessModel    FleetBusinessModel
  numberOfFleets        Int
  approximateRiderCount Int
  vehicleOwnership      VehicleOwnership
  operationalHubCount   Int?
  vehicleCategories     ClientOperationsVehicleCategory[]
  createdAt             DateTime                          @default(now())
  updatedAt             DateTime                          @updatedAt
}

model ClientOperationsVehicleCategory {
  id                  String                  @id @default(uuid())
  clientId            String
  client              Client                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  operationsProfileId String
  operationsProfile   ClientOperationsProfile @relation(fields: [operationsProfileId], references: [id], onDelete: Cascade)
  vehicleCategoryId   String
  vehicleCategory     VehicleCategory         @relation(fields: [vehicleCategoryId], references: [id], onDelete: Restrict)
  createdAt           DateTime                @default(now())

  @@unique([operationsProfileId, vehicleCategoryId])
  @@index([clientId, vehicleCategoryId])
  @@index([vehicleCategoryId])
}

model ClientBillingProfile {
  id                    String   @id @default(uuid())
  clientId              String   @unique
  client                Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  billingContactName    String
  billingEmail          String
  billingMobile         String?
  purchaseOrderRequired Boolean  @default(false)
  poNumber              String?
  paymentTerms          String?
  taxApplicable         Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model ClientDocument {
  id                 String                     @id @default(uuid())
  clientId           String
  client             Client                     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  documentType       ClientDocumentType
  documentNumber     String?
  issueDate          DateTime?                  @db.Date
  expiryDate         DateTime?                  @db.Date
  objectKey          String                     @unique
  fileName           String
  mimeType           String
  sizeBytes          Int
  verificationStatus DocumentVerificationStatus @default(PENDING)
  uploadedAt         DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@index([clientId, documentType, verificationStatus])
}

model ClientAgreement {
  id                      String    @id @default(uuid())
  clientId                String    @unique
  client                  Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorizedSignatoryName String
  designation             String
  termsAcceptedAt         DateTime
  privacyAcceptedAt       DateTime
  dataProcessingConsentAt DateTime
  kycConsentAt            DateTime?
  marketingConsentAt      DateTime?
  submittedAt             DateTime?
  approvedAt              DateTime?
  approvedById            String?
  rejectedAt              DateTime?
  rejectedById            String?
  rejectionReason         String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

model ClientSubscription {
  id                String             @id @default(uuid())
  clientId          String
  client            Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  packageId         String
  package           Package            @relation(fields: [packageId], references: [id], onDelete: Restrict)
  features          ClientFeature[]
  usage             FeatureUsage[]
  billingCycle      BillingCycle
  startDate         DateTime           @db.Date
  endDate           DateTime?          @db.Date
  status            MasterRecordStatus @default(ACTIVE)
  currency          String             @default("INR") @db.VarChar(10)
  listPrice         Decimal            @db.Decimal(14, 2)
  discountType      String?            @db.VarChar(20)
  discountValue     Decimal?           @db.Decimal(14, 2)
  finalPackagePrice Decimal            @db.Decimal(14, 2)
  autoRenew         Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([clientId, status])
}

model ClientFeature {
  id               String                 @id @default(uuid())
  clientId         String
  client           Client                 @relation(fields: [clientId], references: [id], onDelete: Restrict)
  subscriptionId   String
  subscription     ClientSubscription     @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  featureId        String
  feature          Feature                @relation(fields: [featureId], references: [id], onDelete: Restrict)
  source           ClientFeatureSource    @default(ADD_ON)
  enabled          Boolean                @default(true)
  includedQuantity Decimal                @default(0) @db.Decimal(14, 2)
  usageLimit       Decimal?               @db.Decimal(14, 2)
  unlimitedUsage   Boolean                @default(false)
  effectiveFrom    DateTime               @db.Date
  effectiveTo      DateTime?              @db.Date
  configuration    Json?
  pricing          ClientFeaturePricing[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@unique([subscriptionId, featureId])
  @@index([clientId, enabled])
  @@index([featureId, enabled])
}

model ClientFeaturePricing {
  id               String         @id @default(uuid())
  clientFeatureId  String
  clientFeature    ClientFeature  @relation(fields: [clientFeatureId], references: [id], onDelete: Restrict)
  featurePricingId String
  featurePricing   FeaturePricing @relation(fields: [featurePricingId], references: [id], onDelete: Restrict)
  currency         String         @default("INR") @db.VarChar(10)
  listUnitPrice    Decimal        @db.Decimal(14, 4)
  discountType     String?        @db.VarChar(20)
  discountValue    Decimal?       @db.Decimal(14, 4)
  finalUnitPrice   Decimal        @db.Decimal(14, 4)
  setupFee         Decimal        @default(0) @db.Decimal(14, 2)
  effectiveFrom    DateTime       @db.Date
  effectiveTo      DateTime?      @db.Date
  reason           String?        @db.VarChar(500)
  approvedBy       String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([clientFeatureId, effectiveFrom])
  @@index([featurePricingId, effectiveFrom])
}

model FeatureUsage {
  id             String             @id @default(uuid())
  clientId       String
  client         Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  subscriptionId String
  subscription   ClientSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  featureId      String
  feature        Feature            @relation(fields: [featureId], references: [id], onDelete: Restrict)
  usageReference String?            @db.VarChar(150)
  quantity       Decimal            @default(1) @db.Decimal(14, 4)
  usageTimestamp DateTime
  metadata       Json?
  createdAt      DateTime           @default(now())

  @@index([subscriptionId, featureId, usageTimestamp])
  @@index([clientId, usageTimestamp])
}

model Hub {
  id                      String          @id @default(uuid())
  clientId                String
  client                  Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  code                    String          @db.VarChar(50)
  name                    String          @db.VarChar(150)
  type                    HubType         @default(OPERATIONS)
  status                  HubStatus       @default(ACTIVE)
  addressLine1            String?         @db.VarChar(255)
  addressLine2            String?         @db.VarChar(255)
  landmark                String?         @db.VarChar(150)
  city                    String          @default("") @db.VarChar(100)
  district                String?         @db.VarChar(100)
  state                   String          @default("") @db.VarChar(100)
  country                 String          @default("India") @db.VarChar(100)
  postalCode              String?         @db.VarChar(10)
  latitude                Decimal?        @db.Decimal(10, 7)
  longitude               Decimal?        @db.Decimal(10, 7)
  parentHubId             String?
  parentHub               Hub?            @relation("HubHierarchy", fields: [parentHubId], references: [id], onDelete: SetNull)
  childHubs               Hub[]           @relation("HubHierarchy")
  vehicleCapacity         Int?
  riderCapacity           Int?
  batteryCapacity         Int?
  parkingSlots            Int?
  chargingPoints          Int?
  swappingPoints          Int?
  contactName             String?         @db.VarChar(150)
  contactPhone            String?         @db.VarChar(20)
  contactEmail            String?         @db.VarChar(150)
  openingTime             String?         @db.VarChar(5)
  closingTime             String?         @db.VarChar(5)
  is24x7                  Boolean         @default(false)
  supportsCharging        Boolean         @default(false)
  supportsBatterySwapping Boolean         @default(false)
  supportsMaintenance     Boolean         @default(false)
  supportsAllocation      Boolean         @default(true)
  supportsDeallocation    Boolean         @default(true)
  supportsPdi             Boolean         @default(false)
  metadata                Json?
  deletedAt               DateTime?
  userHubs                UserHub[]
  homeFleets              Fleet[]         @relation("FleetHomeHub")
  currentFleets           Fleet[]         @relation("FleetCurrentHub")
  outboundFleetTransfers  FleetTransfer[] @relation("FleetTransferFromHub")
  inboundFleetTransfers   FleetTransfer[] @relation("FleetTransferToHub")
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  @@unique([clientId, code])
  @@index([clientId, status])
  @@index([clientId, city])
  @@index([parentHubId])
}

model Fleet {
  id                 String                   @id @default(uuid())
  clientId           String
  client             Client                   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  fleetCode          String                   @db.VarChar(50)
  vehicleNumber      String?                  @db.VarChar(30)
  chassisNumber      String                   @db.VarChar(100)
  vinNumber          String?                  @db.VarChar(100)
  oemId              String
  oem                Oem                      @relation(fields: [oemId], references: [id], onDelete: Restrict)
  vehicleCategoryId  String
  vehicleCategory    VehicleCategory          @relation(fields: [vehicleCategoryId], references: [id], onDelete: Restrict)
  vehicleTypeId      String
  vehicleType        VehicleType              @relation(fields: [vehicleTypeId], references: [id], onDelete: Restrict)
  speedType          VehicleSpeedType
  modelName          String?                  @db.VarChar(100)
  variantName        String?                  @db.VarChar(100)
  colour             String?                  @db.VarChar(50)
  manufacturingYear  Int?
  manufacturingMonth Int?
  motorNumber        String?                  @db.VarChar(100)
  ownershipType      FleetOwnershipType       @default(CLIENT_OWNED)
  status             FleetStatus              @default(IN_TRANSIT)
  allocationEnabled  Boolean                  @default(true)
  homeHubId          String?
  homeHub            Hub?                     @relation("FleetHomeHub", fields: [homeHubId], references: [id], onDelete: SetNull)
  currentHubId       String?
  currentHub         Hub?                     @relation("FleetCurrentHub", fields: [currentHubId], references: [id], onDelete: SetNull)
  odometerKm         Decimal?                 @db.Decimal(12, 2)
  iotDeviceId        String?                  @unique
  iotDevice          IoTDevice?               @relation("FleetCurrentIoTDevice", fields: [iotDeviceId], references: [id], onDelete: SetNull)
  onboardingStatus   FleetOnboardingStatus    @default(DRAFT)
  onboardedAt        DateTime?
  activatedAt        DateTime?
  deactivatedAt      DateTime?
  metadata           Json?
  registration       FleetRegistration?
  insurance          FleetInsurance?
  fitness            FleetFitness?
  documents          FleetDocument[]
  allocations        Allocation[]
  batteryHistory     FleetBatteryHistory[]
  controllerHistory  FleetControllerHistory[]
  statusHistory      FleetStatusHistory[]
  transfers          FleetTransfer[]
  currentState       VehicleCurrentState?
  deletedAt          DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@unique([clientId, fleetCode])
  @@unique([clientId, vehicleNumber])
  @@unique([clientId, chassisNumber])
  @@unique([clientId, vinNumber])
  @@index([clientId, status])
  @@index([clientId, oemId])
  @@index([clientId, vehicleCategoryId])
  @@index([clientId, vehicleTypeId])
  @@index([clientId, speedType])
  @@index([clientId, currentHubId])
  @@index([clientId, homeHubId])
  @@index([clientId, onboardingStatus])
  @@index([clientId, allocationEnabled])
}

model FleetRegistration {
  id                   String    @id @default(uuid())
  fleetId              String    @unique
  fleet                Fleet     @relation(fields: [fleetId], references: [id], onDelete: Cascade)
  registrationDate     DateTime? @db.Date
  registeringAuthority String?   @db.VarChar(150)
  rcExpiryDate         DateTime? @db.Date
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model FleetInsurance {
  id            String         @id @default(uuid())
  fleetId       String         @unique
  fleet         Fleet          @relation(fields: [fleetId], references: [id], onDelete: Cascade)
  providerName  String?        @db.VarChar(150)
  policyNumber  String?        @db.VarChar(100)
  insuranceType InsuranceType?
  startDate     DateTime?      @db.Date
  endDate       DateTime?      @db.Date
  idv           Decimal?       @db.Decimal(12, 2)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model FleetFitness {
  id                String    @id @default(uuid())
  fleetId           String    @unique
  fleet             Fleet     @relation(fields: [fleetId], references: [id], onDelete: Cascade)
  certificateNumber String?   @db.VarChar(100)
  issueDate         DateTime? @db.Date
  expiryDate        DateTime? @db.Date
  renewalDate       DateTime? @db.Date
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model FleetDocument {
  id             String            @id @default(uuid())
  fleetId        String
  fleet          Fleet             @relation(fields: [fleetId], references: [id], onDelete: Cascade)
  type           FleetDocumentType
  documentNumber String?           @db.VarChar(100)
  objectKey      String            @db.VarChar(500)
  issuedAt       DateTime?         @db.Date
  expiresAt      DateTime?         @db.Date
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([fleetId, type])
  @@index([expiresAt])
}

model IoTDevice {
  id               String               @id @default(uuid())
  clientId         String
  client           Client               @relation(fields: [clientId], references: [id], onDelete: Restrict)
  deviceNumber     String               @db.VarChar(100)
  imei             String?              @db.VarChar(30)
  simNumber        String?              @db.VarChar(30)
  iccid            String?              @db.VarChar(30)
  provider         String?              @db.VarChar(100)
  model            String?              @db.VarChar(100)
  ingestSecretHash String
  status           IoTDeviceStatus      @default(UNASSIGNED)
  installedAt      DateTime?
  activatedAt      DateTime?
  lastHeartbeatAt  DateTime?
  lastLocationAt   DateTime?
  metadata         Json?
  currentFleet     Fleet?               @relation("FleetCurrentIoTDevice")
  currentState     VehicleCurrentState?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([clientId, deviceNumber])
  @@index([clientId, status])
}

model VehicleCurrentState {
  id              String    @id @default(uuid())
  clientId        String
  fleetId         String    @unique
  fleet           Fleet     @relation(fields: [fleetId], references: [id], onDelete: Cascade)
  iotDeviceId     String    @unique
  iotDevice       IoTDevice @relation(fields: [iotDeviceId], references: [id], onDelete: Cascade)
  latitude        Decimal?  @db.Decimal(10, 7)
  longitude       Decimal?  @db.Decimal(10, 7)
  speedKph        Decimal?  @db.Decimal(8, 2)
  ignition        Boolean?
  batterySoc      Int?
  lastHeartbeatAt DateTime?
  lastLocationAt  DateTime?
  isOnline        Boolean   @default(false)
  updatedAt       DateTime  @updatedAt

  @@index([clientId, lastHeartbeatAt])
}

model TelemetryEvent {
  id         BigInt       @id @default(autoincrement())
  clientId   String
  fleetId    String
  deviceId   String
  type       IoTEventType
  occurredAt DateTime
  payload    Json?
  ingestedAt DateTime     @default(now())

  @@index([clientId, fleetId, occurredAt])
}

model Battery {
  id                String                @id @default(uuid())
  clientId          String
  client            Client                @relation(fields: [clientId], references: [id], onDelete: Restrict)
  batteryCode       String?               @db.VarChar(50)
  serialNumber      String                @db.VarChar(100)
  manufacturer      String?               @db.VarChar(100)
  model             String?               @db.VarChar(100)
  chemistry         BatteryChemistry?
  capacityKwh       Decimal?              @db.Decimal(8, 3)
  voltage           Decimal?              @db.Decimal(8, 2)
  ampHour           Decimal?              @db.Decimal(8, 2)
  batteryType       BatteryType
  status            BatteryStatus         @default(AVAILABLE)
  manufacturingDate DateTime?             @db.Date
  warrantyStartDate DateTime?             @db.Date
  warrantyEndDate   DateTime?             @db.Date
  currentSoc        Int?
  currentSoh        Int?
  metadata          Json?
  fleetHistory      FleetBatteryHistory[]
  deletedAt         DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@unique([clientId, serialNumber])
  @@unique([clientId, batteryCode])
  @@index([clientId, status])
}

model FleetBatteryHistory {
  id                  String      @id @default(uuid())
  fleetId             String
  fleet               Fleet       @relation(fields: [fleetId], references: [id], onDelete: Cascade)
  batteryId           String
  battery             Battery     @relation(fields: [batteryId], references: [id], onDelete: Restrict)
  batterySlot         BatterySlot @default(PRIMARY)
  installedAt         DateTime
  removedAt           DateTime?
  installedOdometerKm Decimal?    @db.Decimal(12, 2)
  removedOdometerKm   Decimal?    @db.Decimal(12, 2)
  reason              String?     @db.VarChar(255)
  createdAt           DateTime    @default(now())

  @@index([fleetId, installedAt])
  @@index([batteryId, installedAt])
  @@index([fleetId, batterySlot, removedAt])
}

model Controller {
  id               String                   @id @default(uuid())
  clientId         String
  client           Client                   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  controllerNumber String                   @db.VarChar(100)
  manufacturer     String?                  @db.VarChar(100)
  model            String?                  @db.VarChar(100)
  ratedVoltage     Decimal?                 @db.Decimal(8, 2)
  ratedCurrent     Decimal?                 @db.Decimal(8, 2)
  status           ControllerStatus         @default(AVAILABLE)
  metadata         Json?
  fleetHistory     FleetControllerHistory[]
  deletedAt        DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@unique([clientId, controllerNumber])
  @@index([clientId, status])
}

model FleetControllerHistory {
  id           String     @id @default(uuid())
  fleetId      String
  fleet        Fleet      @relation(fields: [fleetId], references: [id], onDelete: Cascade)
  controllerId String
  controller   Controller @relation(fields: [controllerId], references: [id], onDelete: Restrict)
  installedAt  DateTime
  removedAt    DateTime?
  reason       String?    @db.VarChar(255)
  createdAt    DateTime   @default(now())

  @@index([fleetId, installedAt])
  @@index([controllerId, installedAt])
}

model FleetStatusHistory {
  id              String       @id @default(uuid())
  fleetId         String
  fleet           Fleet        @relation(fields: [fleetId], references: [id], onDelete: Cascade)
  fromStatus      FleetStatus?
  toStatus        FleetStatus
  changedByUserId String?
  reason          String?      @db.VarChar(255)
  createdAt       DateTime     @default(now())

  @@index([fleetId, createdAt])
}

model FleetTransfer {
  id            String              @id @default(uuid())
  clientId      String
  client        Client              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  fleetId       String
  fleet         Fleet               @relation(fields: [fleetId], references: [id], onDelete: Restrict)
  fromHubId     String?
  fromHub       Hub?                @relation("FleetTransferFromHub", fields: [fromHubId], references: [id], onDelete: SetNull)
  toHubId       String
  toHub         Hub                 @relation("FleetTransferToHub", fields: [toHubId], references: [id], onDelete: Restrict)
  status        FleetTransferStatus @default(INITIATED)
  initiatedById String?
  initiatedAt   DateTime            @default(now())
  receivedById  String?
  receivedAt    DateTime?
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([clientId, fleetId])
  @@index([clientId, fromHubId])
  @@index([clientId, toHubId])
}

model User {
  id                String             @id @default(uuid())
  clientId          String?
  client            Client?            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  mobile            String
  name              String
  role              UserRole
  isActive          Boolean            @default(true)
  sessions          Session[]
  rider             Rider?
  hubAssignments    UserHub[]
  teamLeaderProfile TeamLeaderProfile?
  auditLogs         AuditLog[]         @relation("AuditActor")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([clientId, mobile])
  @@index([clientId, role, isActive])
}

model Rider {
  id                     String            @id @default(uuid())
  clientId               String
  client                 Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  userId                 String?           @unique
  user                   User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  name                   String
  mobile                 String
  address                String?
  riderCode              String?           @db.VarChar(50)
  dateOfBirth            DateTime?         @db.Date
  gender                 Gender?
  addressLine1           String?           @db.VarChar(255)
  addressLine2           String?           @db.VarChar(255)
  city                   String?           @db.VarChar(100)
  state                  String?           @db.VarChar(100)
  postalCode             String?           @db.VarChar(10)
  emergencyContactName   String?           @db.VarChar(150)
  emergencyContactMobile String?           @db.VarChar(20)
  status                 RiderStatus       @default(ONBOARDING)
  joiningDate            DateTime?         @db.Date
  exitDate               DateTime?         @db.Date
  metadata               Json?
  deletedAt              DateTime?
  kycs                   RiderKyc[]
  allocations            Allocation[]
  teamLeaders            TeamLeaderRider[]
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@unique([clientId, mobile])
  @@unique([clientId, riderCode])
  @@index([clientId, status])
  @@index([clientId, name])
}

model UserHub {
  id        String   @id @default(uuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hubId     String
  hub       Hub      @relation(fields: [hubId], references: [id], onDelete: Cascade)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, hubId])
  @@index([clientId, hubId])
  @@index([clientId, userId])
}

model TeamLeaderProfile {
  id           String            @id @default(uuid())
  clientId     String
  client       Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId       String            @unique
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode String?           @db.VarChar(50)
  designation  String?           @db.VarChar(100)
  joiningDate  DateTime?         @db.Date
  leavingDate  DateTime?         @db.Date
  metadata     Json?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  deletedAt    DateTime?
  riders       TeamLeaderRider[]

  @@unique([clientId, employeeCode])
  @@index([clientId, deletedAt])
}

model TeamLeaderRider {
  id           String            @id @default(uuid())
  clientId     String
  client       Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  teamLeaderId String
  teamLeader   TeamLeaderProfile @relation(fields: [teamLeaderId], references: [id], onDelete: Cascade)
  riderId      String
  rider        Rider             @relation(fields: [riderId], references: [id], onDelete: Cascade)
  isPrimary    Boolean           @default(true)
  isActive     Boolean           @default(true)
  assignedAt   DateTime          @default(now())
  removedAt    DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([teamLeaderId, riderId])
  @@index([clientId, teamLeaderId, isActive])
  @@index([clientId, riderId, isActive])
}

model ClientOnboardingProgress {
  id          String                       @id @default(uuid())
  clientId    String                       @unique
  client      Client                       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  currentStep ClientOnboardingStep         @default(HUBS)
  submittedAt DateTime?
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt
  steps       ClientOnboardingStepRecord[]
}

model ClientOnboardingStepRecord {
  id          String                     @id @default(uuid())
  clientId    String
  client      Client                     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  progressId  String
  progress    ClientOnboardingProgress   @relation(fields: [progressId], references: [id], onDelete: Cascade)
  step        ClientOnboardingStep
  status      ClientOnboardingStepStatus @default(NOT_STARTED)
  savedAt     DateTime?
  completedAt DateTime?
  skippedAt   DateTime?
  updatedById String?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  @@unique([progressId, step])
  @@index([clientId, step, status])
}

model ImportJob {
  id               String           @id @default(uuid())
  clientId         String
  client           Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  entityType       ImportEntityType
  status           ImportStatus
  originalFilename String
  totalRows        Int              @default(0)
  passedRows       Int              @default(0)
  failedRows       Int              @default(0)
  duplicateRows    Int              @default(0)
  createdRows      Int              @default(0)
  failureReportKey String?
  createdById      String
  createdAt        DateTime         @default(now())
  completedAt      DateTime?
  metadata         Json?

  @@index([clientId, entityType, createdAt])
}

model Allocation {
  id             String           @id @default(uuid())
  clientId       String
  fleetId        String
  fleet          Fleet            @relation(fields: [fleetId], references: [id], onDelete: Restrict)
  riderId        String
  rider          Rider            @relation(fields: [riderId], references: [id], onDelete: Restrict)
  status         AllocationStatus @default(INITIATED)
  allocatedAt    DateTime?
  deallocatedAt  DateTime?
  initiatedById  String
  idempotencyKey String?
  inspections    Inspection[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([clientId, idempotencyKey])
  @@index([clientId, fleetId, status])
  @@index([clientId, riderId, status])
}

model Inspection {
  id           String           @id @default(uuid())
  clientId     String
  allocationId String
  allocation   Allocation       @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  type         InspectionType
  status       InspectionStatus @default(DRAFT)
  checklist    Json?
  completedBy  String?
  completedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([allocationId, type])
  @@index([clientId, status])
}

model RiderKyc {
  id                String    @id @default(uuid())
  clientId          String
  riderId           String
  rider             Rider     @relation(fields: [riderId], references: [id], onDelete: Cascade)
  type              KycType
  status            KycStatus @default(NOT_STARTED)
  provider          String?
  providerReference String?
  maskedData        Json?
  safeFailureCode   String?
  verifiedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([riderId, type])
  @@index([clientId, status])
  @@index([provider, providerReference])
}

model Photo {
  id           String          @id @default(uuid())
  clientId     String
  client       Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  entityType   PhotoEntityType
  entityId     String
  photoType    String
  objectKey    String          @unique
  mimeType     String
  sizeBytes    Int
  status       PhotoStatus     @default(PENDING_UPLOAD)
  uploadedById String
  uploadedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([clientId, entityType, entityId])
  @@index([clientId, status])
}

model PhotoRequirement {
  id         String          @id @default(uuid())
  clientId   String
  entityType PhotoEntityType
  photoType  String
  isRequired Boolean         @default(true)
  sortOrder  Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([clientId, entityType, photoType])
  @@index([clientId, entityType, sortOrder])
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  deviceId         String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId, expiresAt])
}

model AuditLog {
  id           BigInt   @id @default(autoincrement())
  clientId     String?
  client       Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  actorId      String?
  actor        User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action       String
  entityType   String
  entityId     String?
  previousData Json?
  newData      Json?
  requestId    String?
  ipAddress    String?
  createdAt    DateTime @default(now())

  @@index([clientId, entityType, entityId, createdAt])
  @@index([clientId, action, createdAt])
  @@index([actorId, createdAt])
}

model OtpRequest {
  id          String     @id @default(uuid())
  clientId    String?
  purpose     OtpPurpose
  phone       String
  otpHash     String
  context     Json?
  status      OtpStatus  @default(PENDING)
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  expiresAt   DateTime
  verifiedAt  DateTime?
  requestedIp String?
  createdAt   DateTime   @default(now())

  @@index([phone, purpose, createdAt])
  @@index([clientId, status])
}
