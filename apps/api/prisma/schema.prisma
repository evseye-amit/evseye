// Rider cash is a liability: CREDIT increases the rider balance, DEBIT decreases it.
enum WalletStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum WalletAccountType {
  CASH
  SECURITY_DEPOSIT
  REWARD
  RECEIVABLE
  ADJUSTMENT
  CLEARING
  PROVIDER_CLEARING
}

enum WalletTransactionType {
  TOP_UP
  PAYMENT
  RENTAL
  ONBOARDING_FEE
  SECURITY_DEPOSIT
  SECURITY_DEPOSIT_REFUND
  SECURITY_DEPOSIT_DEDUCTION
  SECURITY_DEPOSIT_FORFEITURE
  REWARD
  REFERRAL_REWARD
  SELF_SUBMISSION_REWARD
  REFUND
  PENALTY
  REPAIR_CHARGE
  SERVICE_CHARGE
  BATTERY_CHARGE
  SWAP_CHARGE
  EXCHANGE_FEE
  TRAFFIC_CHALLAN
  ACCESSORY_CHARGE
  LOST_EQUIPMENT_CHARGE
  ADJUSTMENT
  REVERSAL
}

enum WalletTransactionStatus {
  CREATED
  PENDING
  PROCESSING
  POSTED
  FAILED
  CANCELLED
  REVERSED
  PARTIALLY_REVERSED
}

enum WalletEntryType {
  DEBIT
  CREDIT
}

enum WalletHoldStatus {
  ACTIVE
  RELEASED
  CAPTURED
  EXPIRED
  CANCELLED
}

model RiderWallet {
  securityDeposits WalletSecurityDeposit[]
  id               String                  @id @default(uuid())
  clientId         String
  client           Client                  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  riderId          String
  rider            Rider                   @relation(fields: [clientId, riderId], references: [clientId, id], onDelete: Restrict)
  currency         String                  @default("INR") @db.Char(3)
  status           WalletStatus            @default(ACTIVE)
  accounts         WalletAccount[]
  transactions     WalletTransaction[]
  holds            WalletHold[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  createdById      String?
  updatedById      String?

  @@unique([clientId, riderId, currency])
  @@unique([clientId, id])
  @@unique([clientId, riderId, id])
}

model WalletAccount {
  id          String              @id @default(uuid())
  clientId    String
  client      Client              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  walletId    String
  wallet      RiderWallet         @relation(fields: [clientId, walletId], references: [clientId, id], onDelete: Restrict)
  accountType WalletAccountType
  currency    String              @db.Char(3)
  status      WalletStatus        @default(ACTIVE)
  entries     WalletLedgerEntry[]
  holds       WalletHold[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([clientId, walletId, accountType])
  @@unique([clientId, walletId, id])
}

model WalletTransaction {
  id                    String                    @id @default(uuid())
  clientId              String
  client                Client                    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  walletId              String
  wallet                RiderWallet               @relation(fields: [clientId, walletId], references: [clientId, id], onDelete: Restrict)
  transactionNumber     String                    @unique @db.VarChar(60)
  transactionType       WalletTransactionType
  status                WalletTransactionStatus   @default(CREATED)
  currency              String                    @db.Char(3)
  amount                Decimal                   @db.Decimal(18, 2)
  description           String                    @db.VarChar(300)
  referenceType         String?                   @db.VarChar(60)
  referenceId           String?                   @db.VarChar(120)
  idempotencyKey        String                    @db.VarChar(160)
  requestHash           String                    @db.VarChar(64)
  parentTransactionId   String?
  parentTransaction     WalletTransaction?        @relation("WalletReversal", fields: [parentTransactionId], references: [id], onDelete: Restrict)
  reversals             WalletTransaction[]       @relation("WalletReversal")
  metadata              Json?
  entries               WalletLedgerEntry[]
  invoiceAllocations    WalletInvoiceAllocation[]
  rewardClaims          RewardClaim[]
  rewardLotConsumptions RewardLotConsumption[]
  postedAt              DateTime?
  failedAt              DateTime?
  reversedAt            DateTime?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  createdById           String?
  updatedById           String?

  @@unique([clientId, idempotencyKey])
  @@unique([clientId, id])
  @@index([clientId, walletId, createdAt])
}

model WalletLedgerEntry {
  id            String            @id @default(uuid())
  clientId      String
  client        Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  transactionId String
  transaction   WalletTransaction @relation(fields: [clientId, transactionId], references: [clientId, id], onDelete: Restrict)
  walletId      String
  accountId     String
  account       WalletAccount     @relation(fields: [clientId, walletId, accountId], references: [clientId, walletId, id], onDelete: Restrict)
  entryType     WalletEntryType
  amount        Decimal           @db.Decimal(18, 2)
  currency      String            @db.Char(3)
  sequence      Int
  description   String?           @db.VarChar(300)
  createdAt     DateTime          @default(now())
  createdById   String?

  @@unique([transactionId, sequence])
  @@index([clientId, accountId, createdAt])
}

model WalletHold {
  id             String           @id @default(uuid())
  clientId       String
  client         Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  walletId       String
  wallet         RiderWallet      @relation(fields: [clientId, walletId], references: [clientId, id], onDelete: Restrict)
  accountId      String
  account        WalletAccount    @relation(fields: [clientId, walletId, accountId], references: [clientId, walletId, id], onDelete: Restrict)
  amount         Decimal          @db.Decimal(18, 2)
  capturedAmount Decimal          @default(0) @db.Decimal(18, 2)
  currency       String           @db.Char(3)
  status         WalletHoldStatus @default(ACTIVE)
  idempotencyKey String           @db.VarChar(160)
  referenceType  String?          @db.VarChar(60)
  referenceId    String?          @db.VarChar(120)
  reason         String           @db.VarChar(300)
  expiresAt      DateTime?
  releasedAt     DateTime?
  capturedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([clientId, idempotencyKey])
  @@index([clientId, walletId, status])
}

enum WalletDepositStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  LOCKED
  PARTIALLY_DEDUCTED
  REFUND_ELIGIBLE
  REFUND_REQUESTED
  REFUNDED
  FORFEITED
  CANCELLED
}

enum WalletDepositRefundStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  PROCESSING
  RETURNED
  FAILED
  REJECTED
  CANCELLED
}

model WalletPolicy {
  id                                 String    @id @default(uuid())
  clientId                           String
  client                             Client    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  version                            Int
  effectiveFrom                      DateTime  @default(now())
  effectiveUntil                     DateTime?
  allowNegativeCashBalance           Boolean   @default(false)
  negativeBalanceLimit               Decimal   @default(0) @db.Decimal(18, 2)
  minimumCashBalance                 Decimal   @default(0) @db.Decimal(18, 2)
  allowRewardUsage                   Boolean   @default(false)
  maxRewardUsagePercent              Decimal   @default(0) @db.Decimal(5, 2)
  rewardCategories                   String[]  @default([])
  allowDepositDeduction              Boolean   @default(false)
  depositDeductionReasons            String[]  @default([])
  allowPartialSecurityDeposit        Boolean   @default(true)
  requireFullDepositBeforeAllocation Boolean   @default(false)
  allowDepositRefundRequest          Boolean   @default(false)
  fundingPriority                    String[]  @default(["REWARD", "CASH", "EXTERNAL_PAYMENT"])
  createdById                        String?
  createdAt                          DateTime  @default(now())

  @@unique([clientId, version])
  @@index([clientId, effectiveFrom])
}

model WalletSecurityDeposit {
  id             String                       @id @default(uuid())
  clientId       String
  client         Client                       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  riderId        String
  rider          Rider                        @relation(fields: [clientId, riderId], references: [clientId, id], onDelete: Restrict)
  walletId       String
  wallet         RiderWallet                  @relation(fields: [clientId, riderId, walletId], references: [clientId, riderId, id], onDelete: Restrict)
  currency       String                       @db.Char(3)
  requiredAmount Decimal                      @db.Decimal(18, 2)
  sourceType     String                       @db.VarChar(60)
  sourceId       String                       @db.VarChar(120)
  policyVersion  Int
  status         WalletDepositStatus          @default(PENDING)
  lockedAt       DateTime?
  effectiveFrom  DateTime                     @default(now())
  effectiveUntil DateTime?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  createdById    String?
  updatedById    String?
  refundRequests WalletDepositRefundRequest[]

  @@unique([clientId, riderId, sourceType, sourceId])
  @@unique([clientId, id])
  @@index([clientId, walletId, status])
}

model WalletDepositRefundRequest {
  id                String                    @id @default(uuid())
  clientId          String
  client            Client                    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  depositId         String
  deposit           WalletSecurityDeposit     @relation(fields: [clientId, depositId], references: [clientId, id], onDelete: Restrict)
  amount            Decimal                   @db.Decimal(18, 2)
  status            WalletDepositRefundStatus @default(REQUESTED)
  reason            String                    @db.VarChar(500)
  destinationType   String                    @default("WALLET_CASH") @db.VarChar(40)
  externalReference String?                   @db.VarChar(160)
  idempotencyKey    String                    @db.VarChar(160)
  requestedById     String
  approvedById      String?
  approvedAt        DateTime?
  completedAt       DateTime?
  requestedAt       DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@unique([clientId, idempotencyKey])
  @@unique([clientId, externalReference])
  @@index([clientId, depositId, status])
}

enum WalletInvoiceAllocationKind {
  APPLY
  REVERSAL
}

model WalletInvoiceAllocation {
  id            String                      @id @default(uuid())
  clientId      String
  client        Client                      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  invoiceId     String
  invoice       RiderInvoice                @relation(fields: [clientId, invoiceId], references: [clientId, id], onDelete: Restrict)
  transactionId String
  transaction   WalletTransaction           @relation(fields: [clientId, transactionId], references: [clientId, id], onDelete: Restrict)
  kind          WalletInvoiceAllocationKind @default(APPLY)
  sourceType    String                      @db.VarChar(30)
  amount        Decimal                     @db.Decimal(18, 2)
  currency      String                      @db.Char(3)
  reversalOfId  String?
  reversalOf    WalletInvoiceAllocation?    @relation("WalletInvoiceAllocationReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversals     WalletInvoiceAllocation[]   @relation("WalletInvoiceAllocationReversal")
  createdAt     DateTime                    @default(now())
  createdById   String

  @@unique([transactionId, sourceType])
  @@unique([reversalOfId])
  @@index([clientId, invoiceId, createdAt])
}

/// Client-owned reward program. Referral campaigns retain their own commercial rules.
model RewardProgram {
  id          String        @id @default(uuid())
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  code        String        @db.VarChar(100)
  name        String        @db.VarChar(160)
  type        String        @db.VarChar(40)
  status      String        @default("DRAFT") @db.VarChar(20)
  currency    String        @default("INR") @db.Char(3)
  validFrom   DateTime
  validUntil  DateTime?
  totalBudget Decimal?      @db.Decimal(18, 2)
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  rules       RewardRule[]
  claims      RewardClaim[]

  @@unique([clientId, code])
  @@unique([clientId, id])
  @@index([clientId, status, validFrom, validUntil])
}

model RewardRule {
  id               String        @id @default(uuid())
  clientId         String
  programId        String
  program          RewardProgram @relation(fields: [clientId, programId], references: [clientId, id], onDelete: Restrict)
  code             String        @db.VarChar(100)
  name             String        @db.VarChar(160)
  triggerType      String        @db.VarChar(60)
  rewardType       String        @default("FIXED") @db.VarChar(20)
  rewardValue      Decimal       @db.Decimal(18, 2)
  approvalMode     String        @default("MANUAL_APPROVAL") @db.VarChar(30)
  expiryDays       Int?
  expiryAt         DateTime?
  monthlyCountCap  Int?
  monthlyAmountCap Decimal?      @db.Decimal(18, 2)
  version          Int           @default(1)
  isActive         Boolean       @default(true)
  conditions       Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  claims           RewardClaim[]

  @@unique([clientId, programId, code])
  @@unique([clientId, id])
  @@index([clientId, triggerType, isActive])
}

model RewardClaim {
  id                  String             @id @default(uuid())
  clientId            String
  riderId             String
  rider               Rider              @relation(fields: [clientId, riderId], references: [clientId, id], onDelete: Restrict)
  programId           String
  program             RewardProgram      @relation(fields: [clientId, programId], references: [clientId, id], onDelete: Restrict)
  ruleId              String
  rule                RewardRule         @relation(fields: [clientId, ruleId], references: [clientId, id], onDelete: Restrict)
  sourceType          String             @db.VarChar(40)
  sourceId            String             @db.VarChar(120)
  status              String             @default("APPROVAL_PENDING") @db.VarChar(30)
  currency            String             @default("INR") @db.Char(3)
  calculatedAmount    Decimal            @db.Decimal(18, 2)
  creditedAmount      Decimal            @default(0) @db.Decimal(18, 2)
  unrecoveredAmount   Decimal            @default(0) @db.Decimal(18, 2)
  snapshot            Json
  earnedAt            DateTime           @default(now())
  approvedAt          DateTime?
  approvedById        String?
  creditedAt          DateTime?
  expiresAt           DateTime?
  reversedAt          DateTime?
  cancelledAt         DateTime?
  rejectionReason     String?            @db.VarChar(500)
  walletTransactionId String?            @unique
  walletTransaction   WalletTransaction? @relation(fields: [clientId, walletTransactionId], references: [clientId, id], onDelete: Restrict)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  lot                 RewardLot?
  events              RewardEvent[]

  @@unique([clientId, ruleId, sourceType, sourceId, riderId])
  @@unique([clientId, sourceType, sourceId])
  @@unique([clientId, id])
  @@index([clientId, riderId, createdAt])
  @@index([clientId, status, createdAt])
  @@index([clientId, programId, status])
}

model RewardLot {
  id              String                 @id @default(uuid())
  clientId        String
  riderId         String
  claimId         String                 @unique
  claim           RewardClaim            @relation(fields: [clientId, claimId], references: [clientId, id], onDelete: Restrict)
  originalAmount  Decimal                @db.Decimal(18, 2)
  remainingAmount Decimal                @db.Decimal(18, 2)
  expiresAt       DateTime?
  status          String                 @default("AVAILABLE") @db.VarChar(20)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  consumptions    RewardLotConsumption[]

  @@unique([clientId, id])
  @@unique([clientId, claimId])
  @@index([clientId, riderId, status, expiresAt])
}

model RewardLotConsumption {
  id            String            @id @default(uuid())
  clientId      String
  lotId         String
  lot           RewardLot         @relation(fields: [clientId, lotId], references: [clientId, id], onDelete: Restrict)
  transactionId String
  transaction   WalletTransaction @relation(fields: [clientId, transactionId], references: [clientId, id], onDelete: Restrict)
  amount        Decimal           @db.Decimal(18, 2)
  kind          String            @default("SPEND") @db.VarChar(20)
  createdAt     DateTime          @default(now())

  @@unique([lotId, transactionId])
  @@index([clientId, transactionId])
}

model RewardEvent {
  id        String      @id @default(uuid())
  clientId  String
  claimId   String
  claim     RewardClaim @relation(fields: [clientId, claimId], references: [clientId, id], onDelete: Restrict)
  type      String      @db.VarChar(60)
  payload   Json?
  createdAt DateTime    @default(now())

  @@index([clientId, claimId, createdAt])
}
