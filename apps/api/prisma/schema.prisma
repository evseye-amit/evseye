/// Published app-wide legal text. Keep commercial offer terms separate.
model AppLegalDocument {
  id          String   @id @default(uuid())
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  appCode     String   @db.VarChar(40)
  role        UserRole
  kind        String   @db.VarChar(40)
  locale      String   @db.VarChar(10)
  version     String   @db.VarChar(80)
  title       String   @db.VarChar(200)
  content     String
  contentHash String   @db.Char(64)
  effectiveAt DateTime
  publishedAt DateTime?
  retiredAt   DateTime?
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  acceptances AppLegalAcceptance[]

  @@unique([clientId, appCode, role, kind, locale, version])
  @@index([clientId, appCode, role, kind, locale, effectiveAt])
}

/// Platform-owned source documents. They are copied into client drafts, never served to riders.
model AppLegalTemplate {
  id          String   @id @default(uuid())
  appCode     String   @db.VarChar(40)
  role        UserRole
  kind        String   @db.VarChar(40)
  locale      String   @db.VarChar(10)
  version     String   @db.VarChar(80)
  title       String   @db.VarChar(200)
  content     String
  isActive    Boolean  @default(true)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([appCode, role, kind, locale, version])
  @@index([isActive, deletedAt])
}

