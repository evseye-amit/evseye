generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  TENANT_ADMIN
  OPERATIONS_MANAGER
  FLEET_MANAGER
  KYC_OPERATOR
  RIDER
}

enum OtpPurpose {
  LOGIN
  DEALLOCATION_RIDER
  DEALLOCATION_OPERATOR
  PHONE_VERIFICATION
}

enum OtpStatus {
  PENDING
  VERIFIED
  EXPIRED
  FAILED
  CANCELLED
}

enum RiderStatus {
  PENDING
  ACTIVE
  INACTIVE
  BLOCKED
}

enum PhotoEntityType {
  RIDER
  FLEET
  BATTERY
  CONTROLLER
  INSPECTION
}

enum PhotoStatus {
  PENDING_UPLOAD
  COMPLETE
  FAILED
  DELETED
}

enum KycType {
  AADHAAR
  PAN
  BANK_ACCOUNT
}

enum KycStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  FAILED
  RETRY_REQUIRED
}

enum FleetStatus {
  AVAILABLE
  RESERVED
  ALLOCATION_IN_PROGRESS
  ALLOCATED
  IN_USE
  DEALLOCATION_IN_PROGRESS
  INSPECTION_PENDING
  MAINTENANCE
  OUT_OF_SERVICE
  OFFLINE
}

enum AllocationStatus {
  INITIATED
  INSPECTION_PENDING
  OTP_PENDING
  ACTIVE
  DEALLOCATION_INITIATED
  COMPLETED
  CANCELLED
}

enum InspectionType {
  PRE_ALLOCATION
  POST_DEALLOCATION
}

enum InspectionStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum IoTEventType {
  LOCATION
  HEARTBEAT
  START
  STOP
}

enum MasterRecordStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum EnergyType {
  ELECTRIC
  HYBRID
  PETROL
  DIESEL
  CNG
  HYDROGEN
  OTHER
  LPG
}

enum VehicleUsageType {
  PRIVATE
  PASSENGER
  GOODS
  DELIVERY
  SHARED_MOBILITY
  PUBLIC_TRANSPORT
  STAFF_TRANSPORT
  SCHOOL_TRANSPORT
  EMERGENCY
  AGRICULTURAL
  CONSTRUCTION
  INDUSTRIAL
  RENTAL
  GOVERNMENT
  SPECIAL_PURPOSE
}

enum PricingModel {
  FREE
  INCLUDED
  FLAT_FEE
  PER_UNIT
  TIERED
  VOLUME
  PER_USER
  PER_RIDER
  PER_VEHICLE
  PER_FLEET
  USAGE_BASED
  ONE_TIME
  CUSTOM
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
}

enum FeatureCategory {
  RIDER_ONBOARDING
  RIDER_VERIFICATION
  RIDER_TRAINING
  RIDER_MANAGEMENT
  ATTENDANCE
  FACE_RECOGNITION
  FLEET_MANAGEMENT
  VEHICLE_MANAGEMENT
  IOT_TELEMATICS
  TRACKING_GEOFENCING
  BATTERY_MANAGEMENT
  SERVICE_MAINTENANCE
  MECHANIC_MANAGEMENT
  SAFETY_COMPLIANCE
  ANALYTICS
  REPORTING
  NOTIFICATION
  INTEGRATION
  API_ACCESS
  USER_ACCESS
  DOCUMENT_MANAGEMENT
  SUPPORT
  AI_AUTOMATION
}

enum FeatureType {
  BOOLEAN
  QUANTITY
  USAGE_BASED
  CONFIGURATION
}

enum FeatureBillingUnit {
  VERIFICATION
  RIDER
  VEHICLE
  FLEET
  USER
  API_CALL
  FACE_SCAN
  TRAINING
  DEVICE
  MONTH
}

enum PackageType {
  STANDARD
  CUSTOM
  TRIAL
  ADD_ON
  ENTERPRISE
  INTERNAL
}

model Tenant {
  id                String                  @id @default(uuid())
  name              String
  slug              String                  @unique
  isActive          Boolean                 @default(true)
  users             User[]
  riders            Rider[]
  photos            Photo[]
  zones             Zone[]
  hubs              Hub[]
  fleets            Fleet[]
  auditLogs         AuditLog[]
  onboardingConfigs RiderOnboardingConfig[]
  clientProfile     ClientProfile?
  subscriptions     ClientSubscription[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
}

model Oem {
  id            String             @id @default(uuid())
  code          String             @unique
  name          String
  displayName   String
  status        MasterRecordStatus @default(ACTIVE)
  logoUrl       String?
  logoObjectKey String?
  website       String?
  description   String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([status, displayName])
}

model VehicleCategory {
  id           String             @id @default(uuid())
  code         String             @unique
  name         String
  description  String?
  status       MasterRecordStatus @default(ACTIVE)
  displayOrder Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  vehicleTypes VehicleType[]

  @@index([status, displayOrder, name])
}

model VehicleType {
  id          String             @id @default(uuid())
  categoryId  String
  category    VehicleCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  code        String             @unique
  name        String
  subCategory String?
  description String?
  energyType  EnergyType
  usageType   VehicleUsageType?
  status      MasterRecordStatus @default(ACTIVE)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([categoryId, status, name])
}

model Package {
  id            String               @id @default(uuid())
  code          String               @unique
  name          String
  description   String?
  packageType   PackageType          @default(STANDARD)
  monthlyPrice  Decimal?             @db.Decimal(12, 2)
  yearlyPrice   Decimal?             @db.Decimal(12, 2)
  currency      String               @default("INR") @db.Char(3)
  maxFleets     Int?
  maxVehicles   Int?
  maxRiders     Int?
  maxUsers      Int?
  trialDays     Int                  @default(0)
  displayOrder  Int                  @default(0)
  isDefault     Boolean              @default(false)
  isActive      Boolean              @default(true)
  features      PackageFeature[]
  subscriptions ClientSubscription[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([isActive, packageType, displayOrder])
}

model Feature {
  id           String             @id @default(uuid())
  code         String             @unique
  name         String
  category     FeatureCategory
  featureType  FeatureType
  billingUnit  FeatureBillingUnit
  description  String?
  displayOrder Int                @default(0)
  isActive     Boolean            @default(true)
  pricing      FeaturePricing[]
  packageLinks PackageFeature[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([isActive, category, displayOrder])
}

model PackageFeature {
  id               String                  @id @default(uuid())
  packageId        String
  package          Package                 @relation(fields: [packageId], references: [id], onDelete: Cascade)
  featureId        String
  feature          Feature                 @relation(fields: [featureId], references: [id], onDelete: Restrict)
  enabled          Boolean                 @default(true)
  includedQuantity BigInt?
  usageLimit       BigInt?
  unlimitedUsage   Boolean                 @default(false)
  configuration    Json?
  displayOrder     Int                     @default(0)
  pricing          PackageFeaturePricing[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@unique([packageId, featureId])
}

model FeaturePricing {
  id             String                  @id @default(uuid())
  featureId      String
  feature        Feature                 @relation(fields: [featureId], references: [id], onDelete: Cascade)
  pricingName    String?                 @db.VarChar(150)
  pricingModel   PricingModel
  billingUnit    String                  @db.VarChar(50)
  currency       String                  @default("INR") @db.Char(3)
  basePrice      Decimal                 @default(0) @db.Decimal(12, 4)
  unitPrice      Decimal                 @default(0) @db.Decimal(12, 4)
  costPrice      Decimal                 @default(0) @db.Decimal(12, 4)
  minimumCharge  Decimal?                @db.Decimal(12, 2)
  maximumCharge  Decimal?                @db.Decimal(12, 2)
  setupFee       Decimal                 @default(0) @db.Decimal(12, 2)
  billingCycle   BillingCycle?
  taxInclusive   Boolean                 @default(false)
  effectiveFrom  DateTime                @default(now())
  effectiveTo    DateTime?
  isActive       Boolean                 @default(true)
  metadata       Json?
  packagePricing PackageFeaturePricing[]
  tiers          FeaturePricingTier[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([featureId, isActive, effectiveFrom])
}

model PackageFeaturePricing {
  id               String          @id @default(uuid())
  packageFeatureId String
  packageFeature   PackageFeature  @relation(fields: [packageFeatureId], references: [id], onDelete: Cascade)
  featurePricingId String?
  featurePricing   FeaturePricing? @relation(fields: [featurePricingId], references: [id], onDelete: SetNull)
  pricingModel     PricingModel?
  includedQuantity BigInt          @default(0)
  unitPrice        Decimal?        @db.Decimal(12, 4)
  minimumCharge    Decimal?        @db.Decimal(12, 2)
  maximumCharge    Decimal?        @db.Decimal(12, 2)
  effectiveFrom    DateTime
  effectiveTo      DateTime?
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([packageFeatureId, isActive, effectiveFrom])
  @@index([featurePricingId])
}

model FeaturePricingTier {
  id               String         @id @default(uuid())
  featurePricingId String
  featurePricing   FeaturePricing @relation(fields: [featurePricingId], references: [id], onDelete: Cascade)
  tierOrder        Int
  fromQuantity     BigInt
  toQuantity       BigInt?
  unitPrice        Decimal        @db.Decimal(12, 4)
  costPrice        Decimal?       @db.Decimal(12, 4)
  createdAt        DateTime       @default(now())

  @@unique([featurePricingId, tierOrder])
}

model ClientProfile {
  id                     String   @id @default(uuid())
  clientId               String   @unique
  client                 Tenant   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  legalCompanyName       String
  clientType             String
  businessType           String
  industry               String?
  gstin                  String?
  pan                    String
  cinOrLlpin             String?
  website                String?
  logoUrl                String?
  primaryContactName     String
  primaryContactTitle    String
  primaryContactMobile   String
  primaryContactEmail    String
  alternateMobile        String?
  registeredAddressLine1 String
  registeredAddressLine2 String?
  landmark               String?
  city                   String
  district               String
  state                  String
  country                String   @default("India")
  pinCode                String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model ClientSubscription {
  id               String             @id @default(uuid())
  clientId         String
  client           Tenant             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  packageId        String
  package          Package            @relation(fields: [packageId], references: [id], onDelete: Restrict)
  billingCycle     BillingCycle
  packageStartDate DateTime
  trialApplicable  Boolean            @default(false)
  trialDays        Int?
  billingFrequency String
  basePackagePrice Decimal            @db.Decimal(12, 2)
  currency         String             @default("INR") @db.Char(3)
  discountType     String?
  discount         Decimal?           @db.Decimal(12, 2)
  taxRate          Decimal            @default(18) @db.Decimal(5, 2)
  autoRenewal      Boolean            @default(true)
  paymentTerms     String?
  poNumber         String?
  status           MasterRecordStatus @default(ACTIVE)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([clientId, status])
}

model OnboardingStepDefinition {
  stepKey              String                      @id
  displayName          String
  description          String?
  stage                Int
  category             String
  handlerClass         String
  uiComponent          String
  isLockable           Boolean                     @default(false)
  supportsDocument     Boolean                     @default(false)
  supportsRevalidation Boolean                     @default(false)
  defaultEnabled       Boolean                     @default(false)
  defaultMandatory     Boolean                     @default(true)
  tenantEditable       Boolean                     @default(false)
  requiresOpsApproval  Boolean                     @default(true)
  schemaDefinition     Json
  configSteps          RiderOnboardingConfigStep[]
  createdAt            DateTime                    @default(now())
}

model RiderOnboardingConfig {
  id            String                      @id @default(uuid())
  tenantId      String
  tenant        Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  version       Int
  status        String                      @default("DRAFT")
  notes         String?
  effectiveFrom DateTime?
  activatedAt   DateTime?
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt
  steps         RiderOnboardingConfigStep[]

  @@unique([tenantId, version])
  @@index([tenantId, status])
}

model RiderOnboardingConfigStep {
  id                       String                   @id @default(uuid())
  configId                 String
  config                   RiderOnboardingConfig    @relation(fields: [configId], references: [id], onDelete: Cascade)
  stepKey                  String
  definition               OnboardingStepDefinition @relation(fields: [stepKey], references: [stepKey], onDelete: Restrict)
  enabled                  Boolean                  @default(false)
  mandatory                Boolean                  @default(true)
  blocking                 Boolean                  @default(true)
  sequenceNo               Int
  verificationMode         String                   @default("AUTO")
  fallbackMode             String                   @default("MANUAL")
  maxRetryAttempts         Int                      @default(3)
  slaHours                 Int?
  dependsOn                Json
  applicableModels         Json?
  params                   Json
  revalidationIntervalDays Int?
  expiryWarningDays        Int                      @default(15)
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  @@unique([configId, stepKey])
  @@index([configId, sequenceNo])
}

model Zone {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name      String
  code      String
  hubs      Hub[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
}

model Hub {
  id        String   @id @default(uuid())
  tenantId  String
  zoneId    String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  zone      Zone     @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  name      String
  code      String
  fleets    Fleet[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, zoneId])
}

model Fleet {
  id                 String       @id @default(uuid())
  tenantId           String
  tenant             Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  hubId              String?
  hub                Hub?         @relation(fields: [hubId], references: [id], onDelete: SetNull)
  vehicleNumber      String
  chassisNumber      String
  oem                String?
  model              String?
  colour             String?
  vehicleType        String?
  motorNumber        String?
  registrationDate   DateTime?
  insuranceStartDate DateTime?
  insuranceEndDate   DateTime?
  fitnessRenewalDate DateTime?
  status             FleetStatus  @default(AVAILABLE)
  operationalDetails Json?
  batteries          Battery[]
  controllers        Controller[]
  allocations        Allocation[]
  device             IoTDevice?
  deletedAt          DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([tenantId, vehicleNumber])
  @@unique([tenantId, chassisNumber])
  @@index([tenantId, status])
  @@index([tenantId, hubId])
  @@index([tenantId, insuranceEndDate])
}

model IoTDevice {
  id               String   @id @default(uuid())
  tenantId         String
  fleetId          String   @unique
  fleet            Fleet    @relation(fields: [fleetId], references: [id], onDelete: Restrict)
  deviceNumber     String
  ingestSecretHash String
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([tenantId, deviceNumber])
}

model VehicleCurrentState {
  id            String    @id @default(uuid())
  tenantId      String
  fleetId       String    @unique
  deviceId      String    @unique
  latitude      Decimal?  @db.Decimal(9, 6)
  longitude     Decimal?  @db.Decimal(9, 6)
  speedKph      Decimal?  @db.Decimal(6, 2)
  ignition      Boolean?
  lastHeartbeat DateTime?
  lastLocation  DateTime?
  updatedAt     DateTime  @updatedAt

  @@index([tenantId, lastHeartbeat])
}

model TelemetryEvent {
  id         BigInt       @id @default(autoincrement())
  tenantId   String
  fleetId    String
  deviceId   String
  type       IoTEventType
  occurredAt DateTime
  payload    Json?
  ingestedAt DateTime     @default(now())

  @@index([tenantId, fleetId, occurredAt])
}

model Battery {
  id           String   @id @default(uuid())
  tenantId     String
  fleetId      String
  fleet        Fleet    @relation(fields: [fleetId], references: [id], onDelete: Restrict)
  serialNumber String
  batteryType  String?
  capacityWh   Int?
  manufacturer String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, serialNumber])
  @@index([tenantId, fleetId])
}

model Controller {
  id           String   @id @default(uuid())
  tenantId     String
  fleetId      String
  fleet        Fleet    @relation(fields: [fleetId], references: [id], onDelete: Restrict)
  serialNumber String
  manufacturer String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, serialNumber])
  @@index([tenantId, fleetId])
}

model User {
  id        String     @id @default(uuid())
  tenantId  String?
  tenant    Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  mobile    String
  name      String
  role      UserRole
  isActive  Boolean    @default(true)
  sessions  Session[]
  rider     Rider?
  auditLogs AuditLog[] @relation("AuditActor")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([tenantId, mobile])
  @@index([tenantId, role, isActive])
}

model Rider {
  id          String       @id @default(uuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userId      String?      @unique
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  name        String
  mobile      String
  address     String?
  status      RiderStatus  @default(PENDING)
  deletedAt   DateTime?
  kycs        RiderKyc[]
  allocations Allocation[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([tenantId, mobile])
  @@index([tenantId, status])
  @@index([tenantId, name])
}

model Allocation {
  id             String           @id @default(uuid())
  tenantId       String
  fleetId        String
  fleet          Fleet            @relation(fields: [fleetId], references: [id], onDelete: Restrict)
  riderId        String
  rider          Rider            @relation(fields: [riderId], references: [id], onDelete: Restrict)
  status         AllocationStatus @default(INITIATED)
  allocatedAt    DateTime?
  deallocatedAt  DateTime?
  initiatedById  String
  idempotencyKey String?
  inspections    Inspection[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, fleetId, status])
  @@index([tenantId, riderId, status])
}

model Inspection {
  id           String           @id @default(uuid())
  tenantId     String
  allocationId String
  allocation   Allocation       @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  type         InspectionType
  status       InspectionStatus @default(DRAFT)
  checklist    Json?
  completedBy  String?
  completedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([allocationId, type])
  @@index([tenantId, status])
}

model RiderKyc {
  id                String    @id @default(uuid())
  tenantId          String
  riderId           String
  rider             Rider     @relation(fields: [riderId], references: [id], onDelete: Cascade)
  type              KycType
  status            KycStatus @default(NOT_STARTED)
  provider          String?
  providerReference String?
  maskedData        Json?
  safeFailureCode   String?
  verifiedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([riderId, type])
  @@index([tenantId, status])
  @@index([provider, providerReference])
}

model Photo {
  id           String          @id @default(uuid())
  tenantId     String
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  entityType   PhotoEntityType
  entityId     String
  photoType    String
  objectKey    String          @unique
  mimeType     String
  sizeBytes    Int
  status       PhotoStatus     @default(PENDING_UPLOAD)
  uploadedById String
  uploadedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, status])
}

model PhotoRequirement {
  id         String          @id @default(uuid())
  tenantId   String
  entityType PhotoEntityType
  photoType  String
  isRequired Boolean         @default(true)
  sortOrder  Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([tenantId, entityType, photoType])
  @@index([tenantId, entityType, sortOrder])
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  deviceId         String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId, expiresAt])
}

model AuditLog {
  id           BigInt   @id @default(autoincrement())
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actorId      String?
  actor        User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action       String
  entityType   String
  entityId     String?
  previousData Json?
  newData      Json?
  requestId    String?
  ipAddress    String?
  createdAt    DateTime @default(now())

  @@index([tenantId, entityType, entityId, createdAt])
  @@index([tenantId, action, createdAt])
  @@index([actorId, createdAt])
}

model OtpRequest {
  id          String     @id @default(uuid())
  tenantId    String?
  purpose     OtpPurpose
  phone       String
  otpHash     String
  context     Json?
  status      OtpStatus  @default(PENDING)
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  expiresAt   DateTime
  verifiedAt  DateTime?
  requestedIp String?
  createdAt   DateTime   @default(now())

  @@index([phone, purpose, createdAt])
  @@index([tenantId, status])
}
