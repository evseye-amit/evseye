generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  CLIENT_ADMIN
  OPERATIONS_MANAGER
  FLEET_MANAGER
  KYC_OPERATOR
  RIDER
}

enum OtpPurpose {
  LOGIN
  DEALLOCATION_RIDER
  DEALLOCATION_OPERATOR
  PHONE_VERIFICATION
}

enum OtpStatus {
  PENDING
  VERIFIED
  EXPIRED
  FAILED
  CANCELLED
}

enum RiderStatus {
  PENDING
  ACTIVE
  INACTIVE
  BLOCKED
}

enum PhotoEntityType {
  RIDER
  FLEET
  BATTERY
  CONTROLLER
  INSPECTION
}

enum PhotoStatus {
  PENDING_UPLOAD
  COMPLETE
  FAILED
  DELETED
}

enum KycType {
  AADHAAR
  PAN
  BANK_ACCOUNT
}

enum KycStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  FAILED
  RETRY_REQUIRED
}

enum FleetStatus {
  AVAILABLE
  RESERVED
  ALLOCATION_IN_PROGRESS
  ALLOCATED
  IN_USE
  DEALLOCATION_IN_PROGRESS
  INSPECTION_PENDING
  MAINTENANCE
  OUT_OF_SERVICE
  OFFLINE
}

enum AllocationStatus {
  INITIATED
  INSPECTION_PENDING
  OTP_PENDING
  ACTIVE
  DEALLOCATION_INITIATED
  COMPLETED
  CANCELLED
}

enum InspectionType {
  PRE_ALLOCATION
  POST_DEALLOCATION
}

enum InspectionStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum IoTEventType {
  LOCATION
  HEARTBEAT
  START
  STOP
}

enum MasterRecordStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum EnergyType {
  ELECTRIC
  HYBRID
  PETROL
  DIESEL
  CNG
  HYDROGEN
  OTHER
  LPG
}

enum VehicleUsageType {
  PRIVATE
  PASSENGER
  GOODS
  DELIVERY
  SHARED_MOBILITY
  PUBLIC_TRANSPORT
  STAFF_TRANSPORT
  SCHOOL_TRANSPORT
  EMERGENCY
  AGRICULTURAL
  CONSTRUCTION
  INDUSTRIAL
  RENTAL
  GOVERNMENT
  SPECIAL_PURPOSE
}

enum PricingModel {
  FREE
  INCLUDED
  FLAT_FEE
  PER_UNIT
  TIERED
  VOLUME
  PER_USER
  PER_RIDER
  PER_VEHICLE
  PER_FLEET
  USAGE_BASED
  PER_DEVICE
  ONE_TIME
  CUSTOM
}

enum BillingCycle {
  ONCE
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
}

enum ClientFeatureSource {
  PACKAGE
  ADD_ON
  CUSTOM
  PROMOTIONAL
}

enum ClientStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  SUSPENDED
}

enum ClientContactRole {
  PRIMARY
  ACCOUNT_ADMIN
  BILLING
}

enum ClientAddressType {
  REGISTERED
  BILLING
}

enum ClientDocumentType {
  PAN_CARD
  GST_CERTIFICATE
  INCORPORATION_CERTIFICATE
  FLEET_AGREEMENT
  BUSINESS_AGREEMENT
}

enum DocumentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum FleetBusinessModel {
  OWNED
  LEASED
  ATTACHED
  MIXED
}

enum VehicleOwnership {
  OWNED
  LEASED
  DRIVER_OWNED
  MIXED
}

enum FeatureCategory {
  LOGIN
  RIDER_ONBOARDING
  RIDER_VERIFICATION
  RIDER_TRAINING
  RIDER_MANAGEMENT
  ATTENDANCE
  FACE_RECOGNITION
  FLEET_MANAGEMENT
  VEHICLE_MANAGEMENT
  IOT_TELEMATICS
  TRACKING_GEOFENCING
  BATTERY_MANAGEMENT
  SERVICE_MAINTENANCE
  MECHANIC_MANAGEMENT
  SAFETY_COMPLIANCE
  ANALYTICS
  REPORTING
  NOTIFICATION
  INTEGRATION
  API_ACCESS
  USER_ACCESS
  DOCUMENT_MANAGEMENT
  USER_VERIFICATION
  COUPON
  TRAINING
  SUPPORT
  AI_AUTOMATION
}

enum FeatureType {
  BOOLEAN
  QUANTITY
  USAGE_BASED
  CONFIGURATION
}

enum FeatureBillingUnit {
  VERIFICATION
  RIDER
  VEHICLE
  FLEET
  USER
  API_CALL
  FACE_SCAN
  TRAINING
  DEVICE
  MONTH
  LIFE_TIME
}

model Client {
  id                String                  @id @default(uuid())
  name              String
  slug              String                  @unique
  companyCode       String?                 @unique
  status            ClientStatus            @default(DRAFT)
  isActive          Boolean                 @default(true)
  users             User[]
  riders            Rider[]
  photos            Photo[]
  hubs              Hub[]
  fleets            Fleet[]
  auditLogs         AuditLog[]
  businessProfile   ClientBusinessProfile?
  contacts          ClientContact[]
  addresses         ClientAddress[]
  operationsProfile ClientOperationsProfile?
  billingProfile    ClientBillingProfile?
  documents         ClientDocument[]
  agreement         ClientAgreement?
  subscriptions     ClientSubscription[]
  clientFeatures    ClientFeature[]
  featureUsage      FeatureUsage[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

}

model Oem {
  id            String             @id @default(uuid())
  code          String             @unique
  name          String
  displayName   String
  status        MasterRecordStatus @default(ACTIVE)
  logoUrl       String?
  logoObjectKey String?
  website       String?
  description   String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([status, displayName])
}

model VehicleCategory {
  id           String             @id @default(uuid())
  code         String             @unique
  name         String
  description  String?
  status       MasterRecordStatus @default(ACTIVE)
  displayOrder Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  vehicleTypes VehicleType[]

  @@index([status, displayOrder, name])
}

model VehicleType {
  id          String             @id @default(uuid())
  categoryId  String
  category    VehicleCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  code        String             @unique
  name        String
  subCategory String?
  description String?
  energyType  EnergyType
  usageType   VehicleUsageType?
  status      MasterRecordStatus @default(ACTIVE)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  clientOperations ClientOperationsProfile[]

  @@index([categoryId, status, name])
}

model Package {
  id            String               @id @default(uuid())
  code          String               @unique
  name          String
  description   String?
  monthlyPrice  Decimal?             @db.Decimal(12, 2)
  yearlyPrice   Decimal?             @db.Decimal(12, 2)
  currency      String               @default("INR") @db.Char(3)
  maxFleets     Int?
  maxRiders     Int?
  trialDays     Int                  @default(0)
  displayOrder  Int                  @default(0)
  isCustom      Boolean              @default(false)
  isActive      Boolean              @default(true)
  features      PackageFeature[]
  subscriptions ClientSubscription[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([isActive, isCustom, displayOrder])
}

model Feature {
  id           String             @id @default(uuid())
  code         String             @unique
  name         String
  category     FeatureCategory
  featureType  FeatureType
  billingUnit  FeatureBillingUnit
  description  String?
  displayOrder Int                @default(0)
  isActive     Boolean            @default(true)
  pricing      FeaturePricing[]
  packageLinks PackageFeature[]
  clientLinks  ClientFeature[]
  usage        FeatureUsage[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([isActive, category, displayOrder])
}

model PackageFeature {
  id               String                  @id @default(uuid())
  packageId        String
  package          Package                 @relation(fields: [packageId], references: [id], onDelete: Cascade)
  featureId        String
  feature          Feature                 @relation(fields: [featureId], references: [id], onDelete: Restrict)
  enabled          Boolean                 @default(true)
  includedQuantity BigInt?
  usageLimit       BigInt?
  unlimitedUsage   Boolean                 @default(false)
  configuration    Json?
  displayOrder     Int                     @default(0)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@unique([packageId, featureId])
}

model FeaturePricing {
  id             String                  @id @default(uuid())
  featureId      String
  feature        Feature                 @relation(fields: [featureId], references: [id], onDelete: Cascade)
  pricingModel   PricingModel
  billingUnit    FeatureBillingUnit
  currency       String                  @default("INR") @db.Char(3)
  basePrice      Decimal                 @default(0) @db.Decimal(12, 3)
  unitPrice      Decimal                 @default(0) @db.Decimal(12, 3)
  costPrice      Decimal                 @default(0) @db.Decimal(12, 3)
  minimumCharge  Decimal?                @db.Decimal(12, 2)
  maximumCharge  Decimal?                @db.Decimal(12, 2)
  setupFee       Decimal                 @default(0) @db.Decimal(12, 2)
  billingCycle   BillingCycle?
  taxInclusive   Boolean                 @default(false)
  effectiveFrom  DateTime                @default(now())
  effectiveTo    DateTime?
  isActive       Boolean                 @default(true)
  metadata       Json?
  tiers          FeaturePricingTier[]
  clientPricing  ClientFeaturePricing[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([featureId, isActive, effectiveFrom])
}

model FeaturePricingTier {
  id               String         @id @default(uuid())
  featurePricingId String
  featurePricing   FeaturePricing @relation(fields: [featurePricingId], references: [id], onDelete: Cascade)
  tierOrder        Int
  tierName         String?        @db.VarChar(100)
  fromQuantity     BigInt
  toQuantity       BigInt?
  unitPrice        Decimal        @db.Decimal(12, 3)
  costPrice        Decimal?       @db.Decimal(12, 3)
  createdAt        DateTime       @default(now())

  @@unique([featurePricingId, tierOrder])
}

model ClientBusinessProfile {
  id                     String   @id @default(uuid())
  clientId               String   @unique
  client                 Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  legalCompanyName       String
  clientType             String
  businessType           String
  industry               String?
  gstin                  String?
  pan                    String
  cinOrLlpin             String?
  website                String?
  logoUrl                String?
  logoObjectKey          String?
  yearEstablished        Int?
  estimatedFleetSize     Int?
  estimatedRiderCount    Int?
  estimatedUserCount     Int?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model ClientContact {
  id               String            @id @default(uuid())
  clientId         String
  client           Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  role             ClientContactRole
  name             String
  designation      String?
  mobile           String?
  email            String?
  alternateMobile  String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([clientId, role])
  @@index([clientId, role])
}

model ClientAddress {
  id          String            @id @default(uuid())
  clientId    String
  client      Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type        ClientAddressType
  line1       String
  line2       String?
  landmark    String?
  city        String
  district    String?
  state       String
  country     String            @default("India")
  pinCode     String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([clientId, type])
}

model ClientOperationsProfile {
  id                     String             @id @default(uuid())
  clientId               String             @unique
  client                 Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fleetBusinessModel     FleetBusinessModel
  numberOfFleets         Int
  approximateRiderCount  Int
  vehicleOwnership       VehicleOwnership
  primaryVehicleTypeId   String
  primaryVehicleType     VehicleType        @relation(fields: [primaryVehicleTypeId], references: [id], onDelete: Restrict)
  operationalHubCount    Int?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([primaryVehicleTypeId])
}

model ClientBillingProfile {
  id                 String   @id @default(uuid())
  clientId           String   @unique
  client             Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  billingContactName String
  billingEmail       String
  billingMobile      String?
  purchaseOrderRequired Boolean @default(false)
  poNumber           String?
  paymentTerms       String?
  taxApplicable      Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model ClientDocument {
  id                 String                     @id @default(uuid())
  clientId           String
  client             Client                     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  documentType       ClientDocumentType
  documentNumber     String?
  issueDate          DateTime?                  @db.Date
  expiryDate         DateTime?                  @db.Date
  objectKey          String                     @unique
  fileName           String
  mimeType           String
  sizeBytes          Int
  verificationStatus DocumentVerificationStatus @default(PENDING)
  uploadedAt         DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@index([clientId, documentType, verificationStatus])
}

model ClientAgreement {
  id                       String   @id @default(uuid())
  clientId                 String   @unique
  client                   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorizedSignatoryName  String
  designation              String
  termsAcceptedAt          DateTime
  privacyAcceptedAt        DateTime
  dataProcessingConsentAt  DateTime
  kycConsentAt             DateTime?
  marketingConsentAt       DateTime?
  submittedAt              DateTime?
  approvedAt               DateTime?
  approvedById             String?
  rejectedAt               DateTime?
  rejectedById             String?
  rejectionReason          String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model ClientSubscription {
  id                String             @id @default(uuid())
  clientId          String
  client            Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  packageId         String
  package           Package            @relation(fields: [packageId], references: [id], onDelete: Restrict)
  features          ClientFeature[]
  usage             FeatureUsage[]
  billingCycle      BillingCycle
  startDate         DateTime           @db.Date
  endDate           DateTime?          @db.Date
  status            MasterRecordStatus @default(ACTIVE)
  currency          String             @default("INR") @db.VarChar(10)
  listPrice         Decimal            @db.Decimal(14, 2)
  discountType      String?            @db.VarChar(20)
  discountValue     Decimal?           @db.Decimal(14, 2)
  finalPackagePrice Decimal            @db.Decimal(14, 2)
  autoRenew         Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([clientId, status])
}

model ClientFeature {
  id               String             @id @default(uuid())
  clientId         String
  client           Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  subscriptionId   String
  subscription     ClientSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  featureId        String
  feature          Feature            @relation(fields: [featureId], references: [id], onDelete: Restrict)
  source           ClientFeatureSource @default(ADD_ON)
  enabled          Boolean            @default(true)
  includedQuantity Decimal            @default(0) @db.Decimal(14, 2)
  usageLimit       Decimal?           @db.Decimal(14, 2)
  unlimitedUsage   Boolean            @default(false)
  effectiveFrom    DateTime           @db.Date
  effectiveTo      DateTime?          @db.Date
  configuration    Json?
  pricing          ClientFeaturePricing[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([subscriptionId, featureId])
  @@index([clientId, enabled])
  @@index([featureId, enabled])
}

model ClientFeaturePricing {
  id               String         @id @default(uuid())
  clientFeatureId  String
  clientFeature    ClientFeature  @relation(fields: [clientFeatureId], references: [id], onDelete: Restrict)
  featurePricingId String
  featurePricing   FeaturePricing @relation(fields: [featurePricingId], references: [id], onDelete: Restrict)
  currency         String         @default("INR") @db.VarChar(10)
  listUnitPrice    Decimal        @db.Decimal(14, 4)
  discountType     String?        @db.VarChar(20)
  discountValue    Decimal?       @db.Decimal(14, 4)
  finalUnitPrice   Decimal        @db.Decimal(14, 4)
  setupFee         Decimal        @default(0) @db.Decimal(14, 2)
  effectiveFrom    DateTime       @db.Date
  effectiveTo      DateTime?      @db.Date
  reason           String?        @db.VarChar(500)
  approvedBy       String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([clientFeatureId, effectiveFrom])
  @@index([featurePricingId, effectiveFrom])
}

model FeatureUsage {
  id             String             @id @default(uuid())
  clientId       String
  client         Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  subscriptionId String
  subscription   ClientSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  featureId      String
  feature        Feature            @relation(fields: [featureId], references: [id], onDelete: Restrict)
  usageReference String?            @db.VarChar(150)
  quantity       Decimal            @default(1) @db.Decimal(14, 4)
  usageTimestamp DateTime
  metadata       Json?
  createdAt      DateTime           @default(now())

  @@index([subscriptionId, featureId, usageTimestamp])
  @@index([clientId, usageTimestamp])
}

model Hub {
  id        String   @id @default(uuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  name      String
  code      String
  fleets    Fleet[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, code])
}

model Fleet {
  id                 String       @id @default(uuid())
  clientId           String
  client             Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  hubId              String?
  hub                Hub?         @relation(fields: [hubId], references: [id], onDelete: SetNull)
  vehicleNumber      String
  chassisNumber      String
  oem                String?
  model              String?
  colour             String?
  vehicleType        String?
  motorNumber        String?
  registrationDate   DateTime?
  insuranceStartDate DateTime?
  insuranceEndDate   DateTime?
  fitnessRenewalDate DateTime?
  status             FleetStatus  @default(AVAILABLE)
  operationalDetails Json?
  batteries          Battery[]
  controllers        Controller[]
  allocations        Allocation[]
  device             IoTDevice?
  deletedAt          DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([clientId, vehicleNumber])
  @@unique([clientId, chassisNumber])
  @@index([clientId, status])
  @@index([clientId, hubId])
  @@index([clientId, insuranceEndDate])
}

model IoTDevice {
  id               String   @id @default(uuid())
  clientId         String
  fleetId          String   @unique
  fleet            Fleet    @relation(fields: [fleetId], references: [id], onDelete: Restrict)
  deviceNumber     String
  ingestSecretHash String
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([clientId, deviceNumber])
}

model VehicleCurrentState {
  id            String    @id @default(uuid())
  clientId      String
  fleetId       String    @unique
  deviceId      String    @unique
  latitude      Decimal?  @db.Decimal(9, 6)
  longitude     Decimal?  @db.Decimal(9, 6)
  speedKph      Decimal?  @db.Decimal(6, 2)
  ignition      Boolean?
  lastHeartbeat DateTime?
  lastLocation  DateTime?
  updatedAt     DateTime  @updatedAt

  @@index([clientId, lastHeartbeat])
}

model TelemetryEvent {
  id         BigInt       @id @default(autoincrement())
  clientId   String
  fleetId    String
  deviceId   String
  type       IoTEventType
  occurredAt DateTime
  payload    Json?
  ingestedAt DateTime     @default(now())

  @@index([clientId, fleetId, occurredAt])
}

model Battery {
  id           String   @id @default(uuid())
  clientId     String
  fleetId      String
  fleet        Fleet    @relation(fields: [fleetId], references: [id], onDelete: Restrict)
  serialNumber String
  batteryType  String?
  capacityWh   Int?
  manufacturer String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([clientId, serialNumber])
  @@index([clientId, fleetId])
}

model Controller {
  id           String   @id @default(uuid())
  clientId     String
  fleetId      String
  fleet        Fleet    @relation(fields: [fleetId], references: [id], onDelete: Restrict)
  serialNumber String
  manufacturer String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([clientId, serialNumber])
  @@index([clientId, fleetId])
}

model User {
  id        String     @id @default(uuid())
  clientId  String?
  client    Client?    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  mobile    String
  name      String
  role      UserRole
  isActive  Boolean    @default(true)
  sessions  Session[]
  rider     Rider?
  auditLogs AuditLog[] @relation("AuditActor")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([clientId, mobile])
  @@index([clientId, role, isActive])
}

model Rider {
  id          String       @id @default(uuid())
  clientId    String
  client      Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  userId      String?      @unique
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  name        String
  mobile      String
  address     String?
  status      RiderStatus  @default(PENDING)
  deletedAt   DateTime?
  kycs        RiderKyc[]
  allocations Allocation[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([clientId, mobile])
  @@index([clientId, status])
  @@index([clientId, name])
}

model Allocation {
  id             String           @id @default(uuid())
  clientId       String
  fleetId        String
  fleet          Fleet            @relation(fields: [fleetId], references: [id], onDelete: Restrict)
  riderId        String
  rider          Rider            @relation(fields: [riderId], references: [id], onDelete: Restrict)
  status         AllocationStatus @default(INITIATED)
  allocatedAt    DateTime?
  deallocatedAt  DateTime?
  initiatedById  String
  idempotencyKey String?
  inspections    Inspection[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([clientId, idempotencyKey])
  @@index([clientId, fleetId, status])
  @@index([clientId, riderId, status])
}

model Inspection {
  id           String           @id @default(uuid())
  clientId     String
  allocationId String
  allocation   Allocation       @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  type         InspectionType
  status       InspectionStatus @default(DRAFT)
  checklist    Json?
  completedBy  String?
  completedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([allocationId, type])
  @@index([clientId, status])
}

model RiderKyc {
  id                String    @id @default(uuid())
  clientId          String
  riderId           String
  rider             Rider     @relation(fields: [riderId], references: [id], onDelete: Cascade)
  type              KycType
  status            KycStatus @default(NOT_STARTED)
  provider          String?
  providerReference String?
  maskedData        Json?
  safeFailureCode   String?
  verifiedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([riderId, type])
  @@index([clientId, status])
  @@index([provider, providerReference])
}

model Photo {
  id           String          @id @default(uuid())
  clientId     String
  client       Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  entityType   PhotoEntityType
  entityId     String
  photoType    String
  objectKey    String          @unique
  mimeType     String
  sizeBytes    Int
  status       PhotoStatus     @default(PENDING_UPLOAD)
  uploadedById String
  uploadedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([clientId, entityType, entityId])
  @@index([clientId, status])
}

model PhotoRequirement {
  id         String          @id @default(uuid())
  clientId   String
  entityType PhotoEntityType
  photoType  String
  isRequired Boolean         @default(true)
  sortOrder  Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([clientId, entityType, photoType])
  @@index([clientId, entityType, sortOrder])
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  deviceId         String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId, expiresAt])
}

model AuditLog {
  id           BigInt   @id @default(autoincrement())
  clientId     String?
  client       Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  actorId      String?
  actor        User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action       String
  entityType   String
  entityId     String?
  previousData Json?
  newData      Json?
  requestId    String?
  ipAddress    String?
  createdAt    DateTime @default(now())

  @@index([clientId, entityType, entityId, createdAt])
  @@index([clientId, action, createdAt])
  @@index([actorId, createdAt])
}

model OtpRequest {
  id          String     @id @default(uuid())
  clientId    String?
  purpose     OtpPurpose
  phone       String
  otpHash     String
  context     Json?
  status      OtpStatus  @default(PENDING)
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  expiresAt   DateTime
  verifiedAt  DateTime?
  requestedIp String?
  createdAt   DateTime   @default(now())

  @@index([phone, purpose, createdAt])
  @@index([clientId, status])
}
