model PaymentTransaction {
  id                 String                   @id @default(uuid())
  debitNumber        String?                  @unique @db.VarChar(50)
  clientId           String
  client             Client                   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  riderId            String
  rider              Rider                    @relation(fields: [clientId, riderId], references: [clientId, id], onDelete: Restrict)
  invoiceId          String
  invoice            RiderInvoice             @relation(fields: [clientId, invoiceId], references: [clientId, id], onDelete: Restrict)
  mandateId          String
  mandate            PaymentMandate           @relation(fields: [clientId, mandateId], references: [clientId, id], onDelete: Restrict)
  requestKey         String                   @db.VarChar(120)
  provider           String                   @default("CASHFREE") @db.VarChar(30)
  providerPaymentId  String                   @db.VarChar(250)
  providerReference  String?                  @db.VarChar(120)
  failureCode        String?                  @db.VarChar(80)
  retryability       String?                  @db.VarChar(20)
  status             PaymentTransactionStatus @default(CREATING)
  amount             Decimal                  @db.Decimal(14, 2)
  currency           String                   @default("INR") @db.Char(3)
  scheduledAt        DateTime
  preDebitNotifiedAt DateTime?
  completedAt        DateTime?
  lastVerifiedAt     DateTime?
  riderPaymentId     String?                  @unique
  riderPayment       RiderPayment?            @relation(fields: [riderPaymentId], references: [id], onDelete: Restrict)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  attempts           PaymentAttempt[]
  providerEvents     PaymentProviderEvent[]

  @@unique([clientId, id])
  @@unique([clientId, requestKey])
  @@unique([provider, providerPaymentId])
  @@index([clientId, invoiceId, status])
  @@index([clientId, riderId, status])
  @@index([clientId, mandateId, status])
}

model PaymentAttempt {
  id                  String                    @id @default(uuid())
  clientId            String
  client              Client                    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  transactionId       String?
