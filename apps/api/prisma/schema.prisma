  WEEKLY
  FORTNIGHTLY
  MONTHLY
  QUARTERLY
  CUSTOM
}

enum RiderChargeNature {
  ONE_TIME
  RECURRING
  USAGE_BASED
  REFUNDABLE_DEPOSIT
  PENALTY
  ADJUSTMENT
}

enum RiderAdjustmentCalculationType {
  FIXED_AMOUNT
  PERCENTAGE
}

enum RiderAdjustmentType {
