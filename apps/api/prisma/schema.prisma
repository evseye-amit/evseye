  document    AppLegalDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  deviceId    String?          @db.VarChar(128)
  acceptedAt  DateTime         @default(now())
  deviceAcceptedAt DateTime?
  contentHash String           @db.Char(64)

  @@unique([userId, documentId])
  @@index([clientId, userId, acceptedAt])
}

