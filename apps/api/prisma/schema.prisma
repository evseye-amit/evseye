model Client {
  legalDocuments              AppLegalDocument[]
  legalAcceptances            AppLegalAcceptance[]
  kycClientPolicies           KycClientPolicy[]
  featureConsumptions         FeatureUsageConsumption[]
  kycVerifications            KycVerification[]
  kycConsents                 KycConsent[]
  kycCredentials              KycProviderCredential[]
  walletInvoiceAllocations    WalletInvoiceAllocation[]
  walletPolicies              WalletPolicy[]
  walletSecurityDeposits      WalletSecurityDeposit[]
  walletDepositRefundRequests WalletDepositRefundRequest[]
  wallets                     RiderWallet[]
  walletAccounts              WalletAccount[]
  walletTransactions          WalletTransaction[]
  walletEntries               WalletLedgerEntry[]
  walletHolds                 WalletHold[]
  settlementPolicy            ClientSettlementPolicy?
  exchangePolicy              ClientExchangePolicy?
  riderCommercialTerms        RiderCommercialTerms[]
  commercialOffers            RiderCommercialOffer[]
  rentalAgreements            RiderRentalAgreement[]
  riderPromotions             RiderPromotion[]
  riderRateCards              RiderRateCard[]
  batteryPlans                RiderBatteryPlan[]
  vehicleGrades               VehicleCommercialGradeAssignment[]
  id                          String                             @id @default(uuid())
  name                        String
  slug                        String                             @unique
  companyCode                 String?                            @unique
  status                      ClientStatus                       @default(DRAFT)
  isActive                    Boolean                            @default(true)
  domains                     ClientDomain[]
  branding                    ClientBranding?
  users                       User[]
  riders                      Rider[]
  photos                      Photo[]
  hubs                        Hub[]
  fleets                      Fleet[]
  batteries                   Battery[]
  controllers                 Controller[]
  iotDevices                  IoTDevice[]
  fleetTransfers              FleetTransfer[]
  auditLogs                   AuditLog[]
  businessProfile             ClientBusinessProfile?
  contacts                    ClientContact[]
  addresses                   ClientAddress[]
  operationsProfile           ClientOperationsProfile?
  billingProfile              ClientBillingProfile?
  documents                   ClientDocument[]
  agreement                   ClientAgreement?
  subscriptions               ClientSubscription[]
  features                    ClientFeature[]
  pricingAdjustments          ClientPricingAdjustment[]
  featureAddOnPurchases       ClientFeatureAddOnPurchase[]
  featureCreditLots           FeatureCreditLot[]
  featureUsageLedger          FeatureUsageLedger[]
  operationVehicleCategories  ClientOperationsVehicleCategory[]
  onboardingProgress          ClientOnboardingProgress?
  onboardingSteps             ClientOnboardingStepRecord[]
  importJobs                  ImportJob[]
  userHubs                    UserHub[]
  teamLeaderProfiles          TeamLeaderProfile[]
  teamLeaderRiders            TeamLeaderRider[]
  riderOnboardingProgress     RiderOnboardingProgress[]
  riderOnboardingDocuments    RiderOnboardingDocument[]
  referralCampaigns           ReferralCampaign[]
  referralIdentities          ReferralIdentity[]
  referrals                   Referral[]
  referralRewards             ReferralReward[]
  rewardPrograms              RewardProgram[]
  referralPayouts             ReferralPayout[]
  referralFraudChecks         ReferralFraudCheck[]
  referralActivityEvents      ReferralActivityEvent[]
  referralNotifications       ReferralNotificationOutbox[]
  referralMilestoneProgress   ReferralMilestoneProgress[]
  riderPaymentProfiles        RiderPaymentProfile[]
  riderCharges                RiderCharge[]
  riderCredits                RiderCredit[]
  riderInvoices               RiderInvoice[]
  riderLedgerEntries          RiderLedgerEntry[]
  riderDeposits               RiderDeposit[]
  depositActivationPolicy     DepositActivationPolicyType        @default(FULL_REQUIRED)
  depositActivationThreshold  Decimal?                           @db.Decimal(14, 2)
  paymentMandates             PaymentMandate[]
  autoPayDunningCases         AutoPayDunningCase[]
  paymentMandateEvents        PaymentMandateEvent[]
  paymentProviderEvents       PaymentProviderEvent[]
  paymentTransactions         PaymentTransaction[]
  paymentAttempts             PaymentAttempt[]
  createdAt                   DateTime                           @default(now())
  updatedAt                   DateTime                           @updatedAt
}

model ClientSettlementPolicy {
  clientId                   String   @id
  client                     Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  depositApplicationEnabled  Boolean  @default(false)
  manualDepositRefundEnabled Boolean  @default(true)
  updatedById                String
  updatedAt                  DateTime @updatedAt
}

model Oem {
  id            String             @id @default(uuid())
  code          String             @unique
  name          String
  displayName   String
  status        MasterRecordStatus @default(ACTIVE)
  logoObjectKey String?
  website       String?
  description   String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  fleets        Fleet[]

  @@index([status, displayName])
}

model VehicleCategory {
  id               String                            @id @default(uuid())
  code             String                            @unique
  name             String
  description      String?
  status           MasterRecordStatus                @default(ACTIVE)
  displayOrder     Int                               @default(0)
  createdAt        DateTime                          @default(now())
  updatedAt        DateTime                          @updatedAt
  vehicleTypes     VehicleType[]
  fleets           Fleet[]
  clientOperations ClientOperationsVehicleCategory[]

  @@index([status, displayOrder, name])
}

model VehicleType {
  id          String             @id @default(uuid())
  categoryId  String
  category    VehicleCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  code        String             @unique
  name        String
  subCategory String?
  description String?
  energyType  EnergyType
  usageType   VehicleUsageType?
  status      MasterRecordStatus @default(ACTIVE)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  fleets      Fleet[]

  @@index([categoryId, status, name])
}

model Package {
  id                 String                      @id @default(uuid())
  code               String                      @unique
  name               String
  description        String?
  setupFee           Decimal                     @default(0) @db.Decimal(12, 2)
  currency           String                      @default("INR") @db.Char(3)
  maxFleets          Int                         @default(2147483647)
  maxRiders          Int                         @default(2147483647)
  maxAdmins          Int                         @default(2147483647)
  maxFleetManagers   Int                         @default(2147483647)
  maxHubs            Int                         @default(2147483647)
  maxTeamLeaders     Int                         @default(2147483647)
  maxClusterManagers Int                         @default(2147483647)
  maxUsers           Int                         @default(2147483647)
  trialDays          Int                         @default(0)
  displayOrder       Int                         @default(0)
  isCustom           Boolean                     @default(false)
  isActive           Boolean                     @default(true)
  features           PackageFeature[]
  vehicleTierPricing PackageVehicleTierPricing[]
  featureAddOns      PackageFeatureAddOn[]
  subscriptions      ClientSubscription[]
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  @@index([isActive, isCustom, displayOrder])
}

model Feature {
  consumptions             FeatureUsageConsumption[]
  id                       String                       @id @default(uuid())
  code                     String                       @unique
  name                     String
  category                 FeatureCategory?             @default(OTHER)
  featureType              FeatureType
  billingUnit              FeatureBillingUnit
  description              String?
  configuration            Json?
  featureStepId            String?
  featureStep              FeatureStep?                 @relation(fields: [featureStepId], references: [id], onDelete: SetNull)
  displayOrder             Int                          @default(0)
  isActive                 Boolean                      @default(true)
  isAddOnEligible          Boolean                      @default(false)
  pricing                  FeaturePricing[]
  packageLinks             PackageFeature[]
  featureAddOns            FeatureAddOn[]
  trainingContents         TrainingContent[]
  riderOnboardingDocuments RiderOnboardingDocument[]
  addOnPurchases           ClientFeatureAddOnPurchase[]
  creditLots               FeatureCreditLot[]
  usageLedger              FeatureUsageLedger[]
  clientFeatures           ClientFeature[]
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt

  @@index([isActive, category, displayOrder])
  @@index([featureStepId])
}

model FeatureStep {
  id           String        @id @default(uuid())
  code         String        @unique
  displayName  String
  description  String?
  translations Json?
  parentId     String?
  parent       FeatureStep?  @relation("FeatureStepHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children     FeatureStep[] @relation("FeatureStepHierarchy")
  features     Feature[]
  displayOrder Int           @default(0)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([parentId, isActive, displayOrder])
}

model PackageFeature {
  id               String               @id @default(uuid())
  packageId        String
  package          Package              @relation(fields: [packageId], references: [id], onDelete: Cascade)
  featureId        String
  feature          Feature              @relation(fields: [featureId], references: [id], onDelete: Restrict)
  isIncluded       Boolean              @default(true)
  includedQuantity Decimal?             @db.Decimal(18, 4)
  resetPeriod      AllowanceResetPeriod @default(NONE)
  isUnlimited      Boolean              @default(false)
  rolloverAllowed  Boolean              @default(false)
  configuration    Json?
  displayOrder     Int                  @default(0)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([packageId, featureId])
}

model FeaturePricing {
  id            String                 @id @default(uuid())
  featureId     String
  feature       Feature                @relation(fields: [featureId], references: [id], onDelete: Cascade)
  billingUnit   FeatureBillingUnit
  currency      String                 @default("INR") @db.Char(3)
  salePrice     Decimal                @db.Decimal(14, 4)
  costPrice     Decimal?               @db.Decimal(14, 4)
  effectiveFrom DateTime               @default(now())
  effectiveTo   DateTime?
  isActive      Boolean                @default(true)
  metadata      Json?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  clientPricing ClientFeaturePricing[]

  @@index([featureId, isActive, effectiveFrom])
}

model PackageVehicleTierPricing {
  id              String          @id @default(uuid())
  packageId       String
  package         Package         @relation(fields: [packageId], references: [id], onDelete: Restrict)
  minVehicles     Int
  maxVehicles     Int?
  pricePerVehicle Decimal         @db.Decimal(14, 4)
  currency        String          @default("INR") @db.Char(3)
  billingPeriod   BillingCycle    @default(MONTHLY)
  tierMode        PricingTierMode @default(VOLUME)
  effectiveFrom   DateTime        @default(now()) @db.Date
  effectiveTo     DateTime?       @db.Date
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([packageId, minVehicles, effectiveFrom])
  @@index([packageId, isActive, effectiveFrom])
}

model FeatureAddOn {
  id                  String                       @id @default(uuid())
  code                String                       @unique
  name                String
  description         String?
  featureId           String
  feature             Feature                      @relation(fields: [featureId], references: [id], onDelete: Restrict)
  quantity            Decimal                      @db.Decimal(18, 4)
  costPrice           Decimal?                     @db.Decimal(14, 4)
  salePrice           Decimal                      @db.Decimal(14, 4)
  discount            Decimal                      @default(0) @db.Decimal(5, 2)
  currency            String                       @default("INR") @db.Char(3)
  validityDays        Int?
