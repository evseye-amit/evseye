  source             FeatureConsumptionSource
  quantity           Decimal                  @default(1) @db.Decimal(18, 4)
  basePrice          Decimal?                 @db.Decimal(14, 4)
  discount           Decimal?                 @db.Decimal(14, 4)
  effectivePrice     Decimal?                 @db.Decimal(14, 4)
  currency           String?                  @db.Char(3)
  pricingReferenceId String?
  policyId           String?
  recognition        KycUsageRecognition
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime?
  occurredAt         DateTime                 @default(now())
  reversedAt         DateTime?
  reversalReason     String?

  @@index([clientId, featureId, occurredAt])
  @@index([subscriptionId, occurredAt])
  @@index([clientId, occurredAt])
}

model KycVerificationAttempt {
  reason                KycAttemptReason        @default(PRIMARY)
  isLateCompletion      Boolean                 @default(false)
  id                    String                  @id @default(uuid())
  verificationId        String
  verification          KycVerification         @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  providerId            String
  provider              KycProviderConfig       @relation(fields: [providerId], references: [id])
  attemptNumber         Int
  status                String
  providerTransactionId String?
  requestStartedAt      DateTime                @default(now())
  responseReceivedAt    DateTime?
  latencyMs             Int?
  httpStatus            Int?
  providerStatus        String?
  normalizedStatus      KycVerificationStatus   @default(PROCESSING)
  failureType           KycFailureType?
  failureCategory       String?
  failureCode           String?
  cost                  Decimal?                @db.Decimal(12, 4)
  currency              String?
  billable              Boolean?
  costSource            String?                 @db.VarChar(40)
  results               KycVerificationResult[]
  createdAt             DateTime                @default(now())

  @@unique([verificationId, attemptNumber])
  @@index([providerId, requestStartedAt])
  @@index([verificationId, reason, requestStartedAt])
  @@index([requestStartedAt, providerId])
}

model KycProviderSlaPolicy {
  id                     String               @id @default(uuid())
  providerId             String
  provider               KycProviderConfig    @relation(fields: [providerId], references: [id], onDelete: Restrict)
  verificationType       KycVerificationType?
  effectiveFrom          DateTime
  effectiveUntil         DateTime?
  availabilityTarget     Decimal?             @db.Decimal(5, 2)
  technicalSuccessTarget Decimal?             @db.Decimal(5, 2)
  p95LatencyTargetMs     Int?
  timeoutRateTarget      Decimal?             @db.Decimal(5, 2)
  minimumSampleSize      Int                  @default(30)
  contractReference      String?              @db.VarChar(150)
  status                 String               @default("ACTIVE")
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  @@index([providerId, verificationType, effectiveFrom, effectiveUntil])
}

enum KycRoutingStrategy {
  PRIORITY
  FALLBACK
  WEIGHTED
  PARALLEL
  HEDGED
  LOWEST_COST
  LOWEST_LATENCY
  SMART
}

enum KycArbitrationMode {
  FIRST_VERIFIED
  FIRST_TERMINAL
  MAJORITY
  ALL_MUST_AGREE
  MANUAL_REVIEW_ON_CONFLICT
}

enum KycAttemptReason {
  PRIMARY
  RETRY
  FALLBACK
  WEIGHTED_SELECTION
  PARALLEL
  HEDGE
  HEALTH_FAILOVER
}

model KycRoutingPolicy {
  id                          String               @id @default(uuid())
  code                        String
  name                        String
  description                 String?
  clientId                    String?
  verificationType            KycVerificationType
  strategy                    KycRoutingStrategy
  status                      String               @default("ACTIVE")
  isDefault                   Boolean              @default(false)
  version                     Int
  maxProvidersPerVerification Int                  @default(1)
  maxAttempts                 Int                  @default(1)
  allowParallel               Boolean              @default(false)
  allowHedging                Boolean              @default(false)
  arbitrationMode             KycArbitrationMode?
  fallbackCategories          Json?
  providers                   KycRoutingProvider[]
  decisions                   KycRoutingDecision[]
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt

  @@unique([code, version, clientId])
  @@index([clientId, verificationType, status, isDefault])
}

model KycRoutingProvider {
  id              String            @id @default(uuid())
  routingPolicyId String
  routingPolicy   KycRoutingPolicy  @relation(fields: [routingPolicyId], references: [id], onDelete: Restrict)
  providerId      String
  provider        KycProviderConfig @relation(fields: [providerId], references: [id], onDelete: Restrict)
  priority        Int
  weight          Int?
  hedgeDelayMs    Int?
  timeoutMs       Int?
  maxAttempts     Int?
  isEnabled       Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([routingPolicyId, providerId])
  @@unique([routingPolicyId, priority])
}

model KycRoutingDecision {
  id                   String             @id @default(uuid())
  verificationId       String             @unique
  verification         KycVerification    @relation(fields: [verificationId], references: [id], onDelete: Restrict)
  routingPolicyId      String?
  routingPolicy        KycRoutingPolicy?  @relation(fields: [routingPolicyId], references: [id], onDelete: Restrict)
  routingPolicyVersion Int
  strategy             KycRoutingStrategy
  selectedProviders    Json
  decisionReason       String
  intelligentPolicyId  String?
  intelligentMode      String?
  intelligenceSnapshot Json?
  createdAt            DateTime           @default(now())

  @@index([routingPolicyId, createdAt])
}

model KycIntelligentRoutingPolicy {
  id                         String                 @id @default(uuid())
  code                       String                 @db.VarChar(80)
  version                    Int
  clientId                   String?
  verificationType           KycVerificationType
  environment                KycProviderEnvironment @default(TEST)
  mode                       String                 @default("STATIC") @db.VarChar(20)
  status                     String                 @default("DRAFT") @db.VarChar(20)
  weights                    Json
  observationWindowMinutes   Int                    @default(60)
  minimumSampleSize          Int                    @default(30)
  maxSnapshotAgeMinutes      Int                    @default(10)
  latencyTargetMs            Int                    @default(1000)
  unknownCostBehavior        String                 @default("NEUTRAL") @db.VarChar(20)
  rolloutPercent             Int                    @default(0)
  maxTechnicalFailurePercent Decimal?               @db.Decimal(5, 2)
  maxP95LatencyMs            Int?
  sourceShadowPolicyId       String?
  effectiveFrom              DateTime               @default(now())
  createdBy                  String
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt

  @@unique([code, version, clientId])
  @@index([clientId, verificationType, environment, status, effectiveFrom])
}

model KycRoutingMetricSnapshot {
  id                   String              @id @default(uuid())
  providerId           String
  verificationType     KycVerificationType
  windowMinutes        Int
  sampleSize           Int
  technicalSuccessRate Decimal?            @db.Decimal(6, 5)
  timeoutRate          Decimal?            @db.Decimal(6, 5)
  p95LatencyMs         Int?
  knownUnitCost        Decimal?            @db.Decimal(12, 4)
  currency             String?             @db.Char(3)
  slaStatus            String?             @db.VarChar(30)
  generatedAt          DateTime            @default(now())

  @@unique([providerId, verificationType, windowMinutes])
  @@index([verificationType, windowMinutes, generatedAt])
}

model KycProviderCircuitState {
  id                  String              @id @default(uuid())
  providerId          String
  verificationType    KycVerificationType
  state               String              @default("CLOSED") @db.VarChar(20)
  consecutiveFailures Int                 @default(0)
  healthyProbes       Int                 @default(0)
  openUntil           DateTime?
  lastFailureAt       DateTime?
  lastProbeAt         DateTime?
  updatedAt           DateTime            @updatedAt

  @@unique([providerId, verificationType])
  @@index([state, openUntil])
}

model KycIntelligentRoutingControl {
  scopeKey  String   @id @db.VarChar(120)
  disabled  Boolean  @default(true)
  reason    String   @db.VarChar(500)
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model KycShadowDecision {
  id               String   @id @default(uuid())
  verificationId   String   @unique
  clientId         String
  policyId         String
  policyVersion    Int
  actualProviderId String?
  shadowProviderId String?
  scoreSnapshot    Json
  reason           String
  createdAt        DateTime @default(now())

  @@index([policyId, createdAt])
  @@index([clientId, createdAt])
}

model KycProviderConflict {
  id             String                @id @default(uuid())
  verificationId String
  verification   KycVerification       @relation(fields: [verificationId], references: [id], onDelete: Restrict)
  providerId     String
  provider       KycProviderConfig     @relation(fields: [providerId], references: [id], onDelete: Restrict)
  resultStatus   KycVerificationStatus
  conflictType   String
  resolution     String
  createdAt      DateTime              @default(now())

  @@unique([verificationId, providerId])
  @@index([verificationId, conflictType])
}

model KycVerificationResult {
  id                String                 @id @default(uuid())
  verificationId    String
  verification      KycVerification        @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  attemptId         String                 @unique
  attempt           KycVerificationAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  verificationType  KycVerificationType
  status            KycVerificationStatus
  matchStatus       String?
  normalizedData    Json
  providerReference String?
  verifiedAt        DateTime?
  createdAt         DateTime               @default(now())

  @@index([verificationId, createdAt])
}

enum KycWorkflowStatus {
  CREATED
  IN_PROGRESS
  ACTION_REQUIRED
  WAITING
  RECONCILING
  DECISION_PENDING
  VERIFIED
  MANUAL_REVIEW
  REJECTED
  FAILED
  CANCELLED
  EXPIRED
}

enum KycStepStatus {
  PENDING
  IN_PROGRESS
  ACTION_REQUIRED
  VERIFIED
  FAILED
  SKIPPED
  EXPIRED
}

enum KycStepFailureBehavior {
  STOP_WORKFLOW
  CONTINUE
  MANUAL_REVIEW
}

enum KycStepActionMode {
  AUTOMATIC
  USER_ACTION
  MANUAL_ACTION
}

enum KycDecisionOutcome {
  PENDING
  VERIFIED
  MANUAL_REVIEW
  REJECTED
}

model KycWorkflowDefinition {
  id              String                 @id @default(uuid())
  code            String
  name            String
  description     String?
  version         Int
  status          String                 @default("ACTIVE")
  isDefault       Boolean                @default(false)
  clientId        String?
  expiryMinutes   Int                    @default(43200)
  matchThresholds Json?
  steps           KycWorkflowStep[]
  executions      KycWorkflowExecution[]
  rules           KycDecisionRule[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@unique([code, version, clientId])
  @@index([clientId, isDefault, status])
}

model KycWorkflowStep {
  id                   String                     @id @default(uuid())
  workflowDefinitionId String
  workflowDefinition   KycWorkflowDefinition      @relation(fields: [workflowDefinitionId], references: [id], onDelete: Restrict)
  code                 String
  name                 String
  verificationType     KycVerificationType
  sequence             Int
  isRequired           Boolean                    @default(true)
  failureBehavior      KycStepFailureBehavior     @default(STOP_WORKFLOW)
  actionMode           KycStepActionMode          @default(USER_ACTION)
  retryPolicy          Json?
  conditionConfig      Json?
  timeoutConfig        Json?
  isActive             Boolean                    @default(true)
  executions           KycWorkflowStepExecution[]
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  @@unique([workflowDefinitionId, code])
  @@unique([workflowDefinitionId, sequence])
}

model KycWorkflowExecution {
  id                          String                     @id @default(uuid())
  clientId                    String
  riderId                     String
  rider                       Rider                      @relation(fields: [clientId, riderId], references: [clientId, id], onDelete: Restrict)
  workflowDefinitionId        String
  workflowDefinition          KycWorkflowDefinition      @relation(fields: [workflowDefinitionId], references: [id], onDelete: Restrict)
  workflowVersion             Int
  status                      KycWorkflowStatus          @default(CREATED)
  reviewPriority              String                     @default("NORMAL")
  reviewAssignedTo            String?
  reviewAssignedAt            DateTime?
  reviewDueAt                 DateTime?
  reviewResolvedAt            DateTime?
  reviewVersion               Int                        @default(0)
  currentStepId               String?
  previousWorkflowExecutionId String?
  idempotencyKey              String?
  startedAt                   DateTime                   @default(now())
  completedAt                 DateTime?
  expiresAt                   DateTime?
  stepExecutions              KycWorkflowStepExecution[]
  decisions                   KycDecision[]
  reconciliations             KycReconciliationResult[]
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt

  @@unique([clientId, idempotencyKey])
  @@index([clientId, riderId, startedAt])
  @@index([clientId, status, expiresAt])
  @@index([clientId, status, updatedAt])
  @@index([clientId, status, reviewPriority, reviewDueAt])
  @@index([reviewAssignedTo, status, reviewDueAt])
}

model KycOperationalAlert {
  id              String    @id @default(uuid())
  dedupeKey       String    @unique
  type            String
  severity        String
  status          String    @default("OPEN")
  clientId        String?
  providerId      String?
  capability      String?
  entityId        String?
  firstSeenAt     DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  occurrenceCount Int       @default(1)
  acknowledgedBy  String?
  acknowledgedAt  DateTime?
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([clientId, status, lastSeenAt])
  @@index([type, status, lastSeenAt])
}

model KycWorkflowStepExecution {
  id                  String               @id @default(uuid())
  workflowExecutionId String
  workflowExecution   KycWorkflowExecution @relation(fields: [workflowExecutionId], references: [id], onDelete: Restrict)
  workflowStepId      String
  workflowStep        KycWorkflowStep      @relation(fields: [workflowStepId], references: [id], onDelete: Restrict)
  verificationId      String?              @unique
  verification        KycVerification?     @relation(fields: [verificationId], references: [id], onDelete: Restrict)
  status              KycStepStatus        @default(PENDING)
  startedAt           DateTime?
  completedAt         DateTime?
  failureReason       String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([workflowExecutionId, workflowStepId])
  @@index([workflowExecutionId, status])
}

model KycDecisionRule {
  id                   String                 @id @default(uuid())
  code                 String
  name                 String
  workflowDefinitionId String?
  workflowDefinition   KycWorkflowDefinition? @relation(fields: [workflowDefinitionId], references: [id], onDelete: Restrict)
  priority             Int
  condition            Json
  action               KycDecisionOutcome
  reasonCode           String
  isActive             Boolean                @default(true)
  decisions            KycDecision[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@unique([code, workflowDefinitionId])
  @@index([workflowDefinitionId, isActive, priority])
}

model KycDecision {
  id                  String               @id @default(uuid())
  workflowExecutionId String
  workflowExecution   KycWorkflowExecution @relation(fields: [workflowExecutionId], references: [id], onDelete: Restrict)
  decision            KycDecisionOutcome
  reasonCode          String
  ruleId              String?
  rule                KycDecisionRule?     @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  summary             String?
  reviewerId          String?
  decidedAt           DateTime             @default(now())
  createdAt           DateTime             @default(now())

  @@index([workflowExecutionId, decidedAt])
}

model KycReconciliationResult {
  id                  String               @id @default(uuid())
  workflowExecutionId String
  workflowExecution   KycWorkflowExecution @relation(fields: [workflowExecutionId], references: [id], onDelete: Restrict)
  type                String
  sourceA             String
  sourceB             String
  status              String
  score               Int?
  details             Json?
  createdAt           DateTime             @default(now())

  @@unique([workflowExecutionId, type])
}

model Photo {
  id                      String                   @id @default(uuid())
  clientId                String
  client                  Client                   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  entityType              PhotoEntityType
  entityId                String
  photoType               String
  objectKey               String                   @unique
  mimeType                String
  sizeBytes               Int
  status                  PhotoStatus              @default(PENDING_UPLOAD)
  uploadedById            String
  uploadedAt              DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  riderOnboardingDocument RiderOnboardingDocument?

  @@index([clientId, entityType, entityId])
  @@index([clientId, status])
}

model RiderOnboardingDocument {
  id              String                    @id @default(uuid())
  clientId        String
  client          Client                    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId          String
  user            User                      @relation("RiderOnboardingDocumentUploader", fields: [userId], references: [id], onDelete: Cascade)
  riderId         String?
  rider           Rider?                    @relation(fields: [riderId], references: [id], onDelete: SetNull)
  featureId       String
  feature         Feature                   @relation(fields: [featureId], references: [id], onDelete: Restrict)
  fieldCode       String
  photoId         String                    @unique
  photo           Photo                     @relation(fields: [photoId], references: [id], onDelete: Restrict)
  status          RiderDocumentReviewStatus @default(PENDING)
  rejectionReason String?
  reviewedById    String?
  reviewedAt      DateTime?
  supersededAt    DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@index([clientId, userId, fieldCode, status])
  @@index([clientId, riderId, status])
  @@index([clientId, status, createdAt])
}

model PhotoRequirement {
  id         String          @id @default(uuid())
  clientId   String
  entityType PhotoEntityType
  photoType  String
  isRequired Boolean         @default(true)
  sortOrder  Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([clientId, entityType, photoType])
  @@index([clientId, entityType, sortOrder])
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  deviceId         String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId, expiresAt])
}

model AuditLog {
  id           BigInt   @id @default(autoincrement())
  clientId     String?
  client       Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  actorId      String?
  actor        User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action       String
  entityType   String
  entityId     String?
  previousData Json?
  newData      Json?
  requestId    String?
  ipAddress    String?
  createdAt    DateTime @default(now())

  @@index([clientId, entityType, entityId, createdAt])
  @@index([clientId, action, createdAt])
  @@index([actorId, createdAt])
}

model OtpRequest {
  id          String     @id @default(uuid())
  clientId    String?
  purpose     OtpPurpose
  phone       String
  otpHash     String
  context     Json?
  status      OtpStatus  @default(PENDING)
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  expiresAt   DateTime
  verifiedAt  DateTime?
  requestedIp String?
  createdAt   DateTime   @default(now())

  @@index([phone, purpose, createdAt])
  @@index([clientId, status])
}

enum ClientDomainType {
  EVSEYE_SUBDOMAIN
  CUSTOM_DOMAIN
}

model ClientDomain {
  id                String           @id @default(uuid())
  clientId          String
  client            Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  hostname          String           @unique
  type              ClientDomainType
  isPrimary         Boolean          @default(false)
  isVerified        Boolean          @default(false)
  verificationToken String           @default(uuid())
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([clientId])
}

model ClientBranding {
  id               String   @id @default(uuid())
  clientId         String   @unique
  client           Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  logoObjectKey    String?
  faviconObjectKey String?
  primaryColor     String   @default("#176b4c")
  secondaryColor   String   @default("#e4f2e9")
  accentColor      String   @default("#27865f")
  loginTitle       String   @default("Welcome back")
  loginSubtitle    String   @default("Sign in to your EV fleet workspace.")
  supportEmail     String?
  supportPhone     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// Campaign commercial and eligibility rules become immutable after activation.
/// A new campaign must be created for changed terms; each Referral also snapshots them.
model ReferralCampaign {
  id                            String                      @id @default(uuid())
  clientId                      String
  client                        Client                      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  code                          String
  name                          String
  description                   String?
  displayTitle                  String?
  displayDescription            String?
  shareMessageTemplate          String?
  termsAndConditions            String
  status                        ReferralCampaignStatus      @default(DRAFT)
  startAt                       DateTime
  endAt                         DateTime
  registrationValidityDays      Int
  qualificationValidityDays     Int
  referrerRewardType            ReferralRewardType?
  referrerRewardValue           Decimal                     @default(0) @db.Decimal(14, 2)
  refereeRewardType             ReferralRewardType?
  refereeRewardValue            Decimal                     @default(0) @db.Decimal(14, 2)
  maxReferralsPerRider          Int?
  referralLimitPeriod           ReferralLimitPeriod         @default(LIFETIME)
  maxQualifiedReferralsPerRider Int?
  maxRewardPerRider             Decimal?                    @db.Decimal(14, 2)
  campaignBudget                Decimal?                    @db.Decimal(14, 2)
  budgetReserved                Decimal                     @default(0) @db.Decimal(14, 2)
  currency                      String                      @default("INR") @db.Char(3)
  createdById                   String
  updatedById                   String
  activatedAt                   DateTime?
  createdAt                     DateTime                    @default(now())
  updatedAt                     DateTime                    @updatedAt
  milestones                    ReferralCampaignMilestone[]
  referrals                     Referral[]
  rewards                       ReferralReward[]

  @@unique([clientId, code])
  @@unique([clientId, id])
  @@index([clientId, status, startAt, endAt])
}

model ReferralCampaignMilestone {
  id            String                      @id @default(uuid())
  campaignId    String
  campaign      ReferralCampaign            @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  milestoneType ReferralMilestoneType
  operator      ReferralMilestoneOperator   @default(GTE)
  targetValue   Decimal                     @db.Decimal(16, 4)
  sequence      Int
  mandatory     Boolean                     @default(true)
  config        Json?
  isActive      Boolean                     @default(true)
  createdAt     DateTime                    @default(now())
  progress      ReferralMilestoneProgress[]

  @@unique([campaignId, milestoneType])
  @@unique([campaignId, sequence])
}

model ReferralIdentity {
  id        String   @id @default(uuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  riderId   String   @unique
  rider     Rider    @relation(fields: [clientId, riderId], references: [clientId, id], onDelete: Restrict)
  code      String   @unique @db.VarChar(24)
  createdAt DateTime @default(now())

  @@unique([clientId, riderId])
  @@index([clientId, code])
}

model Referral {
  id                      String                       @id @default(uuid())
  clientId                String
  client                  Client                       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  campaignId              String
  campaign                ReferralCampaign             @relation(fields: [clientId, campaignId], references: [clientId, id], onDelete: Restrict)
  referrerRiderId         String
  referrerRider           Rider                        @relation("ReferralReferrer", fields: [clientId, referrerRiderId], references: [clientId, id], onDelete: Restrict)
  refereeUserId           String?
  refereeUser             User?                        @relation("ReferralRefereeUser", fields: [clientId, refereeUserId], references: [clientId, id], onDelete: Restrict)
  refereeRiderId          String?
  refereeRider            Rider?                       @relation("ReferralReferee", fields: [clientId, refereeRiderId], references: [clientId, id], onDelete: Restrict)
  referralCode            String                       @db.VarChar(24)
  inviteToken             String?                      @unique @db.VarChar(64)
  attributionSource       ReferralAttributionSource
  status                  ReferralStatus               @default(INVITED)
  ruleSnapshot            Json
  termsSnapshot           String
  invitedAt               DateTime                     @default(now())
  registeredAt            DateTime?
  kycVerifiedAt           DateTime?
  activatedAt             DateTime?
  qualifiedAt             DateTime?
  expiresAt               DateTime
  qualificationDeadlineAt DateTime?
  rejectedAt              DateTime?
  rejectionReason         String?
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  progress                ReferralMilestoneProgress[]
  rewards                 ReferralReward[]
  fraudChecks             ReferralFraudCheck[]
  activityEvents          ReferralActivityEvent[]
  notifications           ReferralNotificationOutbox[]

  @@unique([clientId, refereeUserId])
  @@unique([clientId, refereeRiderId])
  @@unique([clientId, id])
  @@index([clientId, referrerRiderId, createdAt])
  @@index([clientId, campaignId, status])
  @@index([clientId, expiresAt, status])
}

model ReferralMilestoneProgress {
  id            String                    @id @default(uuid())
  clientId      String
  client        Client                    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  referralId    String
  referral      Referral                  @relation(fields: [clientId, referralId], references: [clientId, id], onDelete: Restrict)
  milestoneId   String
  milestone     ReferralCampaignMilestone @relation(fields: [milestoneId], references: [id], onDelete: Restrict)
  milestoneType ReferralMilestoneType
  operator      ReferralMilestoneOperator
  targetValue   Decimal                   @db.Decimal(16, 4)
  currentValue  Decimal                   @default(0) @db.Decimal(16, 4)
  mandatory     Boolean                   @default(true)
  completedAt   DateTime?
  updatedAt     DateTime                  @updatedAt

  @@unique([referralId, milestoneId])
  @@index([clientId, referralId])
}

model ReferralReward {
  id                 String               @id @default(uuid())
  clientId           String
  client             Client               @relation(fields: [clientId], references: [id], onDelete: Restrict)
  referralId         String
  referral           Referral             @relation(fields: [clientId, referralId], references: [clientId, id], onDelete: Restrict)
