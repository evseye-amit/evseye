model PaymentMandate {
  id                     String                 @id @default(uuid())
  mandateNumber          String?                @unique @db.VarChar(50)
  autoDebitEnabled       Boolean                @default(true)
  clientId               String
  client                 Client                 @relation(fields: [clientId], references: [id], onDelete: Restrict)
  riderId                String
  rider                  Rider                  @relation(fields: [clientId, riderId], references: [clientId, id], onDelete: Restrict)
  requestKey             String                 @db.VarChar(120)
  provider               String                 @default("CASHFREE") @db.VarChar(30)
  providerMandateId      String                 @unique @db.VarChar(250)
  authorizationSessionId String?
  status                 PaymentMandateStatus   @default(CREATING)
  providerStatus         String?                @db.VarChar(80)
  mode                   String                 @default("ON_DEMAND") @db.VarChar(30)
  method                 String                 @default("UPI_AUTOPAY") @db.VarChar(30)
  maxAmount              Decimal                @db.Decimal(14, 2)
  authorizationAmount    Decimal?               @db.Decimal(14, 2)
  currency               String                 @default("INR") @db.Char(3)
  expiresAt              DateTime
  authorizedAt           DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  events                 PaymentMandateEvent[]
  providerEvents         PaymentProviderEvent[]
  transactions           PaymentTransaction[]

  @@unique([clientId, riderId, requestKey])
  @@unique([clientId, id])
  @@index([clientId, riderId, status])
}

model PaymentMandateEvent {
