  sequence            Int                       @default(1)
  status              PaymentTransactionStatus  @default(CREATING)
  providerPaymentId   String                    @db.VarChar(250)
  providerReference   String?                   @db.VarChar(120)
  providerStatus      String?                   @db.VarChar(80)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@unique([transactionId, sequence])
  @@unique([collectionRequestId, sequence])
  @@unique([clientId, providerPaymentId])
  @@index([clientId, status, createdAt])
}

model PaymentCollectionPolicy {
