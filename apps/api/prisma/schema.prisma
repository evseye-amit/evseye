generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  TENANT_ADMIN
  OPERATIONS_MANAGER
  FLEET_MANAGER
  KYC_OPERATOR
  RIDER
}

enum OtpPurpose {
  LOGIN
  DEALLOCATION_RIDER
  DEALLOCATION_OPERATOR
  PHONE_VERIFICATION
}

enum OtpStatus {
  PENDING
  VERIFIED
  EXPIRED
  FAILED
  CANCELLED
}

enum RiderStatus {
  PENDING
  ACTIVE
  INACTIVE
  BLOCKED
}

enum PhotoEntityType {
  RIDER
  FLEET
  BATTERY
  CONTROLLER
  INSPECTION
}

enum PhotoStatus {
  PENDING_UPLOAD
  COMPLETE
  FAILED
  DELETED
}

enum KycType {
  AADHAAR
  PAN
  BANK_ACCOUNT
}

enum KycStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  FAILED
  RETRY_REQUIRED
}

enum FleetStatus {
  AVAILABLE
  RESERVED
  ALLOCATION_IN_PROGRESS
  ALLOCATED
  IN_USE
  DEALLOCATION_IN_PROGRESS
  INSPECTION_PENDING
  MAINTENANCE
  OUT_OF_SERVICE
  OFFLINE
}

enum AllocationStatus {
  INITIATED
  INSPECTION_PENDING
  OTP_PENDING
  ACTIVE
  DEALLOCATION_INITIATED
  COMPLETED
  CANCELLED
}

enum InspectionType {
  PRE_ALLOCATION
  POST_DEALLOCATION
}

enum InspectionStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum IoTEventType {
  LOCATION
  HEARTBEAT
  START
  STOP
}

model Tenant {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  isActive  Boolean    @default(true)
  users     User[]
  riders    Rider[]
  photos    Photo[]
  zones     Zone[]
  hubs      Hub[]
  fleets    Fleet[]
  auditLogs AuditLog[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Zone {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name      String
  code      String
  hubs      Hub[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
}

model Hub {
  id        String   @id @default(uuid())
  tenantId  String
  zoneId    String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  zone      Zone     @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  name      String
  code      String
  fleets    Fleet[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, zoneId])
}

model Fleet {
  id                 String      @id @default(uuid())
  tenantId           String
  tenant             Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  hubId              String?
  hub                Hub?        @relation(fields: [hubId], references: [id], onDelete: SetNull)
  vehicleNumber      String
  chassisNumber      String
  oem                String?
  model              String?
  colour             String?
  vehicleType        String?
  motorNumber        String?
  registrationDate   DateTime?
  insuranceStartDate DateTime?
  insuranceEndDate   DateTime?
  fitnessRenewalDate DateTime?
  status             FleetStatus @default(AVAILABLE)
  operationalDetails Json?
  batteries          Battery[]
  controllers        Controller[]
  allocations        Allocation[]
  device             IoTDevice?
  deletedAt          DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@unique([tenantId, vehicleNumber])
  @@unique([tenantId, chassisNumber])
  @@index([tenantId, status])
  @@index([tenantId, hubId])
  @@index([tenantId, insuranceEndDate])
}

model IoTDevice {
  id String @id @default(uuid())
  tenantId String
  fleetId String @unique
  fleet Fleet @relation(fields:[fleetId],references:[id],onDelete:Restrict)
  deviceNumber String
  ingestSecretHash String
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([tenantId,deviceNumber])
}

model VehicleCurrentState {
  id String @id @default(uuid())
  tenantId String
  fleetId String @unique
  deviceId String @unique
  latitude Decimal? @db.Decimal(9,6)
  longitude Decimal? @db.Decimal(9,6)
  speedKph Decimal? @db.Decimal(6,2)
  ignition Boolean?
  lastHeartbeat DateTime?
  lastLocation DateTime?
  updatedAt DateTime @updatedAt
  @@index([tenantId,lastHeartbeat])
}

model TelemetryEvent {
  id BigInt @id @default(autoincrement())
  tenantId String
  fleetId String
  deviceId String
  type IoTEventType
  occurredAt DateTime
  payload Json?
  ingestedAt DateTime @default(now())
  @@index([tenantId,fleetId,occurredAt])
}

model Battery {
  id           String   @id @default(uuid())
  tenantId     String
  fleetId      String
  fleet        Fleet    @relation(fields: [fleetId], references: [id], onDelete: Restrict)
  serialNumber String
  batteryType  String?
  capacityWh   Int?
  manufacturer String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, serialNumber])
  @@index([tenantId, fleetId])
}

model Controller {
  id           String   @id @default(uuid())
  tenantId     String
  fleetId      String
  fleet        Fleet    @relation(fields: [fleetId], references: [id], onDelete: Restrict)
  serialNumber String
  manufacturer String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, serialNumber])
  @@index([tenantId, fleetId])
}

model User {
  id        String    @id @default(uuid())
  tenantId  String?
  tenant    Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  mobile    String
  name      String
  role      UserRole
  isActive  Boolean   @default(true)
  sessions  Session[]
  rider     Rider?
  auditLogs AuditLog[] @relation("AuditActor")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([tenantId, mobile])
  @@index([tenantId, role, isActive])
}

model Rider {
  id        String      @id @default(uuid())
  tenantId  String
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userId    String?     @unique
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  mobile    String
  address   String?
  status    RiderStatus @default(PENDING)
  deletedAt DateTime?
  kycs      RiderKyc[]
  allocations Allocation[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([tenantId, mobile])
  @@index([tenantId, status])
  @@index([tenantId, name])
}

model Allocation {
  id String @id @default(uuid())
  tenantId String
  fleetId String
  fleet Fleet @relation(fields: [fleetId], references: [id], onDelete: Restrict)
  riderId String
  rider Rider @relation(fields: [riderId], references: [id], onDelete: Restrict)
  status AllocationStatus @default(INITIATED)
  allocatedAt DateTime?
  deallocatedAt DateTime?
  initiatedById String
  idempotencyKey String?
  inspections Inspection[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, fleetId, status])
  @@index([tenantId, riderId, status])
}

model Inspection {
  id String @id @default(uuid())
  tenantId String
  allocationId String
  allocation Allocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  type InspectionType
  status InspectionStatus @default(DRAFT)
  checklist Json?
  completedBy String?
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([allocationId, type])
  @@index([tenantId, status])
}

model RiderKyc {
  id                String    @id @default(uuid())
  tenantId          String
  riderId           String
  rider             Rider     @relation(fields: [riderId], references: [id], onDelete: Cascade)
  type              KycType
  status            KycStatus @default(NOT_STARTED)
  provider          String?
  providerReference String?
  maskedData        Json?
  safeFailureCode   String?
  verifiedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([riderId, type])
  @@index([tenantId, status])
  @@index([provider, providerReference])
}

model Photo {
  id           String          @id @default(uuid())
  tenantId     String
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  entityType   PhotoEntityType
  entityId     String
  photoType    String
  objectKey    String          @unique
  mimeType     String
  sizeBytes    Int
  status       PhotoStatus     @default(PENDING_UPLOAD)
  uploadedById String
  uploadedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, status])
}

model PhotoRequirement {
  id         String          @id @default(uuid())
  tenantId   String
  entityType PhotoEntityType
  photoType  String
  isRequired Boolean         @default(true)
  sortOrder  Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([tenantId, entityType, photoType])
  @@index([tenantId, entityType, sortOrder])
}

model Session {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  deviceId         String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime @default(now())

  @@index([userId, expiresAt])
}

model AuditLog {
  id           BigInt    @id @default(autoincrement())
  tenantId     String?
  tenant       Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actorId      String?
  actor        User?     @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action       String
  entityType   String
  entityId     String?
  previousData Json?
  newData      Json?
  requestId    String?
  ipAddress    String?
  createdAt    DateTime  @default(now())

  @@index([tenantId, entityType, entityId, createdAt])
  @@index([tenantId, action, createdAt])
  @@index([actorId, createdAt])
}

model OtpRequest {
  id          String     @id @default(uuid())
  tenantId    String?
  purpose     OtpPurpose
  phone       String
  otpHash     String
  context     Json?
  status      OtpStatus  @default(PENDING)
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  expiresAt   DateTime
  verifiedAt  DateTime?
  requestedIp String?
  createdAt   DateTime   @default(now())

  @@index([phone, purpose, createdAt])
  @@index([tenantId, status])
}
