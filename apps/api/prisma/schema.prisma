  validityDays           Int?
  reverificationRequired Boolean             @default(false)
  usageRecognition       KycUsageRecognition @default(ON_REQUEST)
  overagePolicy          KycOveragePolicy    @default(BLOCK)
  effectiveFrom          DateTime            @default(now())
  effectiveUntil         DateTime?
  status                 String              @default("ACTIVE")
