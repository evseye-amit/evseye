enum KycVerificationType {
  PAN_VERIFICATION
  AADHAAR_OTP
  AADHAAR_OKYC
  BANK_ACCOUNT_VERIFICATION
  IFSC_VERIFICATION
  PAN_AADHAAR_LINK
  DIGILOCKER
  NAME_MATCH
  FACE_MATCH
  LIVENESS
}

enum KycVerificationStatus {
  CREATED
  QUEUED
  PROCESSING
  ACTION_REQUIRED
  OTP_REQUIRED
  VERIFIED
  PARTIALLY_VERIFIED
  FAILED
  REJECTED
  EXPIRED
  CANCELLED
  MANUAL_REVIEW
}

enum KycProviderCode {
  SANDBOX
  CASHFREE
  SUREPASS
  HYPERVERGE
}

enum KycProviderEnvironment {
  TEST
  PRODUCTION
}

enum KycFailureType {
  BUSINESS_FAILURE
  TECHNICAL_FAILURE
}

model KycProviderConfig {
  routingProviders KycRoutingProvider[]
  conflicts        KycProviderConflict[]
  slaPolicies      KycProviderSlaPolicy[]
  id               String                   @id @default(uuid())
  code             KycProviderCode          @unique
  name             String
  status           String                   @default("ACTIVE")
  environment      KycProviderEnvironment   @default(TEST)
  priority         Int                      @default(1)
  isActive         Boolean                  @default(false)
  capabilities     KycProviderCapability[]
  credentials      KycProviderCredential[]
  attempts         KycVerificationAttempt[]
  verifications    KycVerification[]
  consents         KycConsent[]
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
}

model KycProviderCapability {
  id               String              @id @default(uuid())
  providerId       String
  provider         KycProviderConfig   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  verificationType KycVerificationType
  isSupported      Boolean             @default(false)
  isEnabled        Boolean             @default(false)
  timeoutMs        Int                 @default(10000)
  maxRetries       Int                 @default(0)
  costPerRequest   Decimal?            @db.Decimal(12, 4)
  currency         String              @default("INR")
  billingRule      String              @default("UNKNOWN") @db.VarChar(40)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([providerId, verificationType])
}

model KycProviderCredential {
  id              String                 @id @default(uuid())
  providerId      String
  provider        KycProviderConfig      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  clientId        String?
  client          Client?                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  environment     KycProviderEnvironment
  secretReference String
  status          String                 @default("ACTIVE")
  validFrom       DateTime?
  validUntil      DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([providerId, clientId, environment])
}

model KycConsent {
  id               String              @id @default(uuid())
  clientId         String
  client           Client              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  riderId          String
  rider            Rider               @relation(fields: [riderId], references: [id], onDelete: Restrict)
  verificationType KycVerificationType
  providerId       String?
  provider         KycProviderConfig?  @relation(fields: [providerId], references: [id])
  consentVersion   String
  consentTextHash  String
  purpose          String
  reason           String
  accepted         Boolean
  acceptedAt       DateTime?
  channel          String
  verifications    KycVerification[]
  createdAt        DateTime            @default(now())

  @@index([clientId, riderId, verificationType, acceptedAt])
}

model KycVerification {
  featureConsumption             FeatureUsageConsumption?
  routingDecision                KycRoutingDecision?
  providerConflicts              KycProviderConflict[]
  workflowStepExecution          KycWorkflowStepExecution?
  id                             String                    @id @default(uuid())
  clientId                       String
  client                         Client                    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  riderId                        String
  rider                          Rider                     @relation(fields: [riderId], references: [id], onDelete: Restrict)
  verificationType               KycVerificationType
  status                         KycVerificationStatus     @default(CREATED)
  inputFingerprint               String
  idempotencyKey                 String
  recoveryVersion                Int                       @default(0)
  consentId                      String?
  consent                        KycConsent?               @relation(fields: [consentId], references: [id])
  finalProviderId                String?
  finalProvider                  KycProviderConfig?        @relation(fields: [finalProviderId], references: [id])
  finalAttemptId                 String?
  resultCode                     String?
  resultSummary                  String?
  requestedAt                    DateTime                  @default(now())
  startedAt                      DateTime?
  completedAt                    DateTime?
  expiresAt                      DateTime?
  validityDaysSnapshot           Int?
  reverificationRequiredSnapshot Boolean                   @default(false)
  validUntil                     DateTime?
  createdAt                      DateTime                  @default(now())
  updatedAt                      DateTime                  @updatedAt
  attempts                       KycVerificationAttempt[]
  results                        KycVerificationResult[]

  @@unique([clientId, idempotencyKey])
  @@index([clientId, riderId, verificationType])
  @@index([clientId, verificationType, status])
  @@index([clientId, status, createdAt])
  @@index([verificationType, status, createdAt])
  @@index([createdAt])
  @@index([clientId, requestedAt, verificationType])
}

model KycRecoveryRequest {
  id             String   @id @default(uuid())
  clientId       String
  verificationId String
  keyHash        String
  createdAt      DateTime @default(now())

  @@unique([clientId, keyHash])
  @@index([verificationId, createdAt])
}

model KycClientPolicy {
