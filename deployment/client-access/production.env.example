# Template for the production secret/config store; do not commit real credentials.
NODE_ENV=production
APP_BASE_DOMAINS=evseye.com
APP_GENERIC_HOSTS=app.evseye.com,api.evseye.com,admin.evseye.com
CORS_ORIGINS=https://app.evseye.com,https://admin.evseye.com
CLIENT_LOGIN_URL=https://app.evseye.com
# API_INTERNAL_URL is accessible only inside the deployment network.
API_INTERNAL_URL=http://api:3000/api/v1
SESSION_COOKIE_SECURE=true
CLIENT_PROXY_SECRET=<independent-random-secret-at-least-32-characters>
JWT_ACCESS_SECRET=<independent-random-secret-at-least-32-characters>
JWT_REFRESH_SECRET=<independent-random-secret-at-least-32-characters>
OTP_HASH_SECRET=<independent-random-secret-at-least-32-characters>
DATABASE_URL=postgresql://<user>:<password>@<private-database>:5432/evseye?sslmode=require
AWS_REGION=ap-south-1
S3_BUCKET=<private-production-bucket>
S3_SERVER_SIDE_ENCRYPTION=AES256
MEDIA_PUBLIC_BASE_URL=https://media.evseye.com
# Use an IAM task role; omit static AWS keys and local MinIO endpoints.
# Existing SMS/KYC live adapters must be implemented/configured before full-app go-live.
# Do not substitute invented provider names: the modules reject unsupported adapters.
EMAIL_PROVIDER=msg91
MSG91_AUTH_KEY=<secret>
MSG91_EMAIL_DOMAIN=<verified-domain>
MSG91_EMAIL_FROM=<verified-sender>
MSG91_WELCOME_TEMPLATE_ID=<approved-template>
